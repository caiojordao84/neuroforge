racks[1|]{rack|slots|backplane_current|voltage}:
  0|10|8000mA|5.1V

## 6. PERIPHERALS & PROTOCOLS:
# Format: peripheral | param | value
peripherals[4|]{peripheral|param|value}:
  ethernetip|"port:44818"|"mode:single-switch;speed:100Mbps"
  modbus-tcp|"port:502"|"role:server;max_connections:128"
  opc-ua|"port:4840"|"security:basic256;max_sessions:25"
  devicenet|"address:63"|"baud:500kbps;max_nodes:64"

## 7. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "2000mA"
  total_current_limit: "8000mA"
  operating_temp: "0-60C"
  protection_class: IP20
  warnings[4]:
    - "Studio 5000 v24 or later required for 5570 series controllers"
    - "I/O modules shown are representative; actual configuration depends on installed hardware"
    - "Backplane current must not exceed chassis rating across all installed modules"
    - "Controller does not support redundant power supply configurations"
compatibility:
  standard: "IEC 61131-3"
  ide: "Studio 5000 v24+"
  runtime: "Firmware 24.011+"
  languages: "LD;FBD;ST;SFC"

