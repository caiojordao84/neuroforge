ioModules[4|]{slot|rack|type|channels|addr_start|addr_end|current}:
  1|0|DI|32|"%IX0.0"|"%IX3.7"|null
  2|0|DO|32|"%QX0.0"|"%QX3.7"|null
  3|0|AI|16|"%IW0"|"%IW15"|null
