# METADATA:
project_name: controllino-mini-profile
version: 1
editor: dendriForge
author: schemasmith
ASLversion: 0.1.0

## 1. DEVICE IDENTIFICATION:
id: controllino-mini
name: "Controllino MINI"
manufacturer: Controllino
cpu: "ATmega328P"
category: plc
form_factor: compact
standard: "IEC 61131-3"
image: controllino-mini.svg
url: "https://controllino.biz/product/controllino-mini/"

## 2. TECH SPECS & DIMENSIONS:
specs:
  cycle_time: 2
  supply_voltage: 24V
  memory_work: 2KB
  memory_load: 32KB
  memory_retain: 1KB
  power_consumption: 1W
  di_integrated: 6
  do_relay_integrated: 6
  ai_integrated: 8
dims:
  w: 62.0
  h: 40.0
  t: 22.0

## 3. ELECTRICAL PROFILE (POWER SUPPLY):
# Format: name | direction | voltage | type
powerPins[4|]{name|direction|voltage|type}:
  VIN|input|24V|null
  5V|output|"5V"|null
  3V3|output|"3.3V"|null
  GND|null|null|ground

## 4. I/O MODULE MAP:
# Format: slot | rack | type | channels | addr_start | addr_end | current
ioModules[3|]{slot|rack|type|channels|addr_start|addr_end|current}:
  0|0|DI|6|"%IX0.0"|"%IX0.5"|null
  1|0|DO|6|"%QX0.0"|"%QX0.5"|null
  2|0|AI|8|"%IW0"|"%IW7"|null

## 5. PERIPHERALS & PROTOCOLS:
# Format: peripheral | param | value
peripherals[2|]{peripheral|param|value}:
  serial|"baud:19200"|"proto:RS485;isolation:galvanic"
  modbus-rtu|"baud:9600"|"address:1;parity:none"
usb:
  type: Mini-USB
  chip: CH340G
  vid: "0x1A86"
  pid: "0x7523"

## 6. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "40mA"
  total_current_limit: "3000mA"
  max_relay_load: "5A"
  operating_temp: "-20 to 60C"
  protection_class: IP20
  warnings[4]:
    - "No analog output channels — external DAC required for analog control"
    - "Maximum relay load: 5A at 250VAC or 30VDC per channel"
    - "RS-485 requires external 120-ohm termination on multi-drop buses"
    - "No onboard Ethernet — upgrade to MAXI or MEGA for network connectivity"
compatibility:
  standard: "IEC 61131-3"
  ide: "Arduino IDE 2.x"
  runtime: "Controllino v3.x"
  languages: "ST"

## 7. AGENT SKILLS:
dendriForge:
  boardFamilySkillId: plc-family
  boardProfileId: controllino-mini
  defaultLanguageSkills[1]:
    - st-iec61131