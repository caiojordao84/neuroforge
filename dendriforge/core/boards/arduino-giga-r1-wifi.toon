## 6. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "8mA"
  total_current_limit: "800mA"
  warnings[5]:
    - "Logic level is 3.3V — not 5V tolerant; Mega shields must be verified"
    - "CAN bus requires an external transceiver"
    - "D54-D75 on camera/display connectors; not on main headers"
    - "USB-A host port activated via PA_15 signal"
    - "Dual-core: M7 runs Arduino/MicroPython; M4 runs secondary sketch via RPC"
compatibility:
  arduinoCore: "4.0.2"
  pio: ststm32
  frameworks: arduino
  languages: arduino-cpp
  bootloader: stm32h7-dfu

