## 6. PERIPHERALS & PROTOCOLS:
# Format: peripheral | param | value
peripherals[5|]{peripheral|param|value}:
  ethernetip|"port:44818"|"protocol:EtherNet/IP;speed:10-100Mbps"
  modbus-tcp|"port:502"|"role:server"
  modbus-rtu|"baud:19200"|"proto:RS485;role:master-slave"
