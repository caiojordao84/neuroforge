## 7. RESTRICTIONS & COMPATIBILITY:
restrictions:
  supply_voltage: 24V
  supply_current_max: 1000mA
  io_output_current_max: 2000mA
  sensor_supply_current: 400mA
  operating_temp: "-20-65°C"
  storage_temp: "-40-85°C"
  protection_class: IP20
  warnings[7]:
    - "Supply voltage 24V DC (18-26.4V); 120V AC input version is 2080-LC70-24AWB"
    - "Micro870 is 24-point only; no 48-point variant exists (use Micro850 for 48-point)"
    - "6 HS inputs (IX0.0-IX0.5) share channels with up to 6 HSC counters at 100kHz"
    - "Relay outputs (QWB) do not support PTO/PWM; use sourcing DO variant (QBB) for motion"
    - "Analog I/O requires plug-in modules (2080-IF2, 2080-OF2, 2080-IF4); none onboard"
    - "Maximum 8 local expansion I/O modules; maximum total 304 I/O points"
    - "RS232 and RS485 share one non-isolated serial port; cannot be used simultaneously"
compatibility:
  standard: "IEC 61131-3"
  ide: "Connected Components Workbench (CCW) v21+"
  runtime: "Micro870 FW11"
  languages: "LD;FBD;ST;SFC;IL"
  order_ref: "2080-LC70-24QWB"

