## 2. TECH SPECS & DIMENSIONS:
specs:
  cycle_time: 1
  supply_voltage: 24V
  memory_work: 100KB
  memory_load: 4096KB
  memory_retain: 64KB
  power_consumption: 7W
  di_max: 1024
  do_max: 1024
  ai_max: 128
  ao_max: 128
dims:
  w: 15.0
  h: 116.0
  t: 58.0

## 3. ELECTRICAL PROFILE (POWER SUPPLY):
# Format: name | direction | voltage | type
powerPins[3|]{name|direction|voltage|type}:
  L+|input|24V|null
  M|null|null|ground
  PE|null|null|ground

## 4. I/O MODULE MAP:
# Format: slot | rack | type | channels | addr_start | addr_end | current
ioModules[4|]{slot|rack|type|channels|addr_start|addr_end|current}:
  0|0|DI|16|"%IX0.0"|"%IX1.7"|null
  1|0|DO|16|"%QX0.0"|"%QX1.7"|null
  2|0|AI|4|"%IW64"|"%IW67"|null
  3|0|AO|2|"%QW64"|"%QW65"|null

## 5. PERIPHERALS & PROTOCOLS:
# Format: peripheral | param | value
peripherals[3|]{peripheral|param|value}:
  profinet|"port:80"|"speed:100Mbps;mode:switch;ports:2"
  modbus-tcp|"port:502"|"role:server;max_connections:16"
  opc-ua|"port:4840"|"security:basic256sha256"
service:
  type: PROFINET
  connector: RJ45
  protocol: PROFINET

## 6. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "800mA"
  total_current_limit: "2000mA"
  operating_temp: "0-55C"
  protection_class: IP20
  warnings[4]:
    - "Maximum 64 I/O modules per ET 200SP station including CPU"
    - "Base module (BusAdapter) required for mechanical mounting and bus connection"
    - "CPU supports both PROFINET IO controller and IO device simultaneously"
    - "No integrated display; status indicated via LEDs and Web Server"
compatibility:
  standard: "IEC 61131-3"
  ide: "TIA Portal v13-v19"
  runtime: "ET 200SP FW2.0"
  languages: "LD;FBD;ST;SFC"

