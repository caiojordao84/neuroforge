## 5. PERIPHERALS & USB:
# Format: peripheral | param | value
peripherals[4|]{peripheral|param|value}:
  serial|"uarts:1"|"pins:14,15"
  i2c|"channels:1"|"sda:2;scl:3"
  spi|"channels:1"|"miso:9;mosi:10;sck:11;ss:8"
  pwm|"channels:2"|"pwm0:12;pwm1:13"
usb:
  type: Micro-USB-OTG
  chip: onboard
  vid: "0x2E8A"
  pid: "0x0003"

## 6. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "16mA"
  total_current_limit: "800mA"
  warnings[6]:
    - "GPIO0/GPIO1 (pins 27/28) are reserved for HAT EEPROM ID — avoid general use"
    - "No onboard ADC — external ADC required for analog inputs"
    - "GPIO2/GPIO3 have onboard pull-up resistors (1.8kΩ)"
    - "3.3V I/O only — do NOT connect 5V signals to GPIO pins"
    - "Micro USB OTG port shares power and data — cannot use as host without adapter"
    - "Flash storage via microSD only — no onboard flash"
compatibility:
  pio: raspberrypi
  frameworks: "linux;bare-metal"
  languages: "python;c-cpp"
  bootloader: rpi-bootloader

## 7. AGENT SKILLS:
dendriForge:
  boardFamilySkillId: rpi-arm-cortex-a53-family
  boardProfileId: raspberry-pi-zero-2-w
  defaultLanguageSkills[2]:
