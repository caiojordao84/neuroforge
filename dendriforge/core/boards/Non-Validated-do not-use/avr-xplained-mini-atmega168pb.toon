  AREF|input|null|null

## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
gpio[23|]{pin|type|pwm|int|label|roles}:
  0|digital|false|false|"PD0 / D0 / RXD (USART0)"|uart-rx
  1|digital|false|false|"PD1 / D1 / TXD (USART0)"|uart-tx
  2|digital|false|true|"PD2 / D2 / INT0 / BTN"|btn
  3|digital|true|true|"PD3 / D3 / INT1 / OC2B"|null
  4|digital|false|false|"PD4 / D4 / T0 / XCK"|null
  5|digital|true|false|"PD5 / D5 / OC0B / T1"|null
  6|digital|true|false|"PD6 / D6 / OC0A / AIN0"|null
  7|digital|false|false|"PD7 / D7 / AIN1"|null
  8|digital|false|false|"PB0 / D8 / ICP1 / CLKO"|null
  9|digital|true|false|"PB1 / D9 / OC1A"|null
  10|digital|true|false|"PB2 / D10 / SS / OC1B"|spi-ss
  11|digital|true|false|"PB3 / D11 / MOSI / OC2A"|spi-mosi
  12|digital|false|false|"PB4 / D12 / MISO"|spi-miso
  13|digital|false|false|"PB5 / D13 / SCK / LED"|"spi-sck;status-led"
  14|analog|false|false|"PC0 / A0 / ADC0"|"adc:t"
  15|analog|false|false|"PC1 / A1 / ADC1"|"adc:t"
  16|analog|false|false|"PC2 / A2 / ADC2"|"adc:t"
  17|analog|false|false|"PC3 / A3 / ADC3"|"adc:t"
  18|analog|false|false|"PC4 / A4 / ADC4 / SDA (TWI)"|"adc:t;i2c-sda"
  19|analog|false|false|"PC5 / A5 / ADC5 / SCL (TWI)"|"adc:t;i2c-scl"
  20|digital|false|false|"PE0 / TXD1 (USART1 TX — 168PB only)"|uart-tx
  21|digital|false|false|"PE2 / XCK1 (USART1 CLK — 168PB only)"|null
  22|analog|false|false|"ADC6 (input only, TQFP-32)"|"adc:t"

## 5. PERIPHERALS & USB:
# Format: peripheral | param | value
peripherals[5|]{peripheral|param|value}:
  serial|"uarts:2"|"pins:0,1;uart1:PE0"
  i2c|"channels:1"|"sda:18;scl:19"
  spi|"channels:2"|"mosi:11;miso:12;sck:13;ss:10"
  adc|"resolution:10bit"|"pins:14;15;16;17;18;19;22"
  debugwire|"interface:SWD-like"|"via:mEDBG;chip:ATmega32U4"
usb:
  type: Micro-USB
  chip: mEDBG
  vid: "0x03EB"
  pid: "0x2145"

## 6. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "40mA"
  total_current_limit: "200mA"
  warnings[8]:
    - "mEDBG runs on ATmega32U4 (separate chip); provides USB CDC virtual COM, ISP programming and debugWIRE debug"
    - "Target MCU clock is supplied externally by mEDBG: 16 MHz @5V or 8 MHz @3.3V; changing CLK fuses breaks debugWIRE"
    - "ATmega168PB has NO USB native port; USB connection is exclusively via mEDBG ATmega32U4"
    - "168PB adds USART1 (PE0/PE2) and SPI1 (PB0/PE0-PE2) vs 168PA; not all extra pins exposed on Arduino shield headers"
    - "ADC6 and ADC7 are input-only analog pins (TQFP-32 only); not available in PDIP-28 package"
    - "EEPROM is 512 bytes; use avr/eeprom.h or EEPROM library; wear limited — avoid frequent writes in loops"
    - "debugWIRE uses RESET pin; if DWEN fuse is set, SPI programming is disabled — always exit debug with Disable debugWIRE"
    - "Board is Arduino Uno R3 shield compatible (J200-J203) but voltage is 5V; check shield compatibility"
compatibility:
  arduinoCore: "1.8.3"
  pio: atmelavr
  frameworks: arduino
  languages: arduino-cpp
  bootloader: "optiboot-atmega168"

## 7. AGENT SKILLS:
dendriForge:
  boardFamilySkillId: avr-family
