  modbus-tcp|"port:502"|"role:master-slave"
  canopen|"address:1"|"baud:500kbps"
  opc-ua|"port:4840"|null

## 6. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "2000mA"
  total_current_limit: "3000mA"
  warnings[5]:
    - "Class 2 power supply required for UL compliance"
    - "Digital outputs must be supplied from the same source as the OCS unit"
    - "Rechargeable lithium battery backs RTC and retentive registers only — program is in Flash"
    - "Integrated 3.5-inch resistive touchscreen HMI (320x240 QVGA 65K colors)"
    - "MicroSD card slot supports up to 32GB — larger cards not verified"
compatibility:
  standard: "IEC 61131-3"
  ide: "Cscape 10.x"
  runtime: "XL4 OCS Firmware"
  languages: "LD;FBD;ST;IL;SFC"

