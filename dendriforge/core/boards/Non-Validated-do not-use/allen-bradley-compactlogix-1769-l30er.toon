## 3. ELECTRICAL PROFILE (POWER PINS):
# Format: name | direction | voltage | type
# 1769-L30ER has NO built-in power supply — a separate 1769-PA or 1769-PB power supply module is MANDATORY
# 1769-PA2 / 1769-PA4: 120VAC or 240VAC input; 1769-PB2 / 1769-PB4: 24VDC input
# The power supply provides: 5VDC backplane bus (for CPU + I/O modules) and field power 24VDC to I/O modules
# CPU current draw from 5V backplane: 500mA; CPU current draw from 24V: 225mA
# Field power (24VDC) current max: 2A total across all I/O modules (L30ER); protected by internal non-replaceable fuse
# PE: Protective Earth — connect via DIN rail; rail must be earthed
powerPins[5|]{name|direction|voltage|type}:
  5V_BACKPLANE|input|"5V"|null
  24V_FIELD_PWR|input|"24V"|null
  M_COMMON|null|null|ground
  PE_RAIL|null|null|ground
  USB_VBUS|input|"5V"|null

## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# 1769-L30ER has NO integrated field I/O (no DI, DO, AI, AO on CPU module)
# All field I/O is via local 1769 Compact I/O modules (up to 8) or distributed EtherNet/IP I/O
# GPIO map covers the physical communication ports on the CPU front face
gpio[3|]{pin|type|pwm|int|label|roles}:
  0|digital|false|false|"ETH1 / EtherNet/IP Port 1 — RJ45; 10/100 Mbps auto-MDI-X; Part of 2-port embedded DLR switch; ONE shared IP address across both ETH ports; DLR capable for fault-tolerant ring without managed switch; up to 16 EtherNet/IP nodes; protocols: EtherNet/IP CIP, CIP Sync, CIP Motion (L30ERM only), PCCC-on-EIP, open socket TCP-UDP; isolation 30VDC cont 500VAC@60s"|"do;di"
  1|digital|false|false|"ETH2 / EtherNet/IP Port 2 — RJ45; 10/100 Mbps; same embedded switch as ETH1; same single IP address; supports DLR ring topology when connected to another DLR-capable device; linear or star topology also supported; Cat 5e minimum cable"|"do;di"
  2|digital|false|false|"USB / Mini-B — USB 2.0 Full Speed 12 Mbps; for temporary programming connection ONLY; NOT for permanent or industrial connection; use: program upload/download, firmware update, RSLinx Classic; isolation 30VDC cont 500VAC@60s; max cable length 3m; remove after programming"|"do;di"

## 5. PERIPHERALS & USB:
# Format: peripheral | param | value
peripherals[9|]{peripheral|param|value}:
  ethernet_ip_dual|"speed:100Mbit"|"2x-RJ45-embedded-switch;DLR:Device-Level-Ring-fault-tolerant-no-managed-switch;one-IP-addr;nodes-max:16;connections-max:256;sockets-max:32;protocols:EtherNet-IP-CIP,CIP-Sync,open-socket-TCP-UDP,PCCC-on-EIP;cable:Cat5e-min;topology:linear-star-ring-DLR"
  sd_card_nvm|"size:1GB"|"1784-SD1-1GB-SD-card-shipped-with-controller;1784-SD2-2GB-optional;stores:program-firmware-data-log-recipe;load-program-on-powerup;store-and-load-via-MSG-instruction;NOT-removable-during-run-without-data-loss"
  rtc_supercap|"backup:35days"|"hardware-RTC;energy-storage:internal-supercapacitor;holdup:40-days@0C,35-days@25C,28-days@40C,16-days@60C;no-battery-required;L30ER-NSE-variant-has-NO-supercap-no-RTC-holdup"
  io_local_expansion|"modules:8"|"max-8-Bulletin-1769-Compact-I-O-modules-right-of-CPU;max-3-banks-separated-by-1769-PA-or-PB-power-supply;power-supply-distance-rating:4-max-3-IO-modules-between-CPU-and-PSU;types:1769-IQ16-DI,1769-OQ16-DO,1769-IA16-AI,1769-OF4-AO,1769-HSC-counter,1769-SDN-DeviceNet,1769-ASCII,1769-SM2-motion;end-cap-1769-ECR-mandatory-on-last-module"
  io_distributed_eip|"nodes:16"|"up-to-16-EtherNet-IP-I-O-adapter-nodes;types:1734-AENT-POINT-IO,1756-EN2T-ControlLogix-remote,1769-L2-remote-CompactLogix,PowerFlex-755-drives,Kinetix-5500-drives,1203-USM-DeviceNet-via-EIP;RPI-configurable-per-module"
  programming_usb|"speed:12Mbit"|"USB-Mini-B-2.0-Full-Speed;for-temporary-use-only;RSLogix-5000-or-Studio-5000-programming;firmware-update;NOT-for-permanent-industrial-network;cable-max-3m;disconnect-after-use"
  cip_motion_eip|"axes:0"|"L30ER-standard:NO-integrated-motion;L30ERM-variant:up-to-4-axes-via-CIP-Motion-EtherNet-IP;drives:Kinetix-5100-5300-5500-5700;SERCOS-derived-trajectory;motion-planner:Logix-controller;requires-L30ERM-cat-no"
  devicenet_optional|"nodes:64"|"DeviceNet-access-via-1769-SDN-scanner-module-in-local-I-O-rack;scanner-counts-as-1-of-8-local-expansion-modules;max-64-DeviceNet-nodes-per-SDN;master-only;Explicit-and-I-O-messaging;power-supply-distance-rating:4-with-SDN"
  tasks_programs|"tasks:32"|"32-tasks-max:1-continuous+31-periodic-event;100-programs-per-task;event-tasks:EVENT-MESSAGE-MOTION-AXIS-WATCH-CONSUMED-TAG;256-total-controller-connections;32-open-sockets;subroutine-nesting-max:JMP-JSR-unlimited-within-task"
