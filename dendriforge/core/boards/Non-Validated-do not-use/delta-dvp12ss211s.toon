## 3. ELECTRICAL PROFILE (POWER PINS):
# Format: name | direction | voltage | type
# DVP12SS211S: 24VDC (-15%/+20%) = 20.4-28.8VDC; max 7W consumption
# Inrush: 7.5A max @ 24VDC cold start; isolation 1500VAC primary-secondary and primary-PE; 500VAC secondary-PE
# DO power (S/D): Y0-Y3 use separate DO power supply pin; PNP sourcing from S terminal
# COM1 RS-232: powered from CPU (5V level shift internal); not separately powered
# COM2 RS-485: powered from CPU; pin 5 optional signal ground; isolated internally per model
# Left-side module power: provided from CPU 24VDC via module interface (max 1 module)
# Grounding: Class D (<100Ω); use dedicated earth — do not share with high-current circuits
powerPins[5|]{name|direction|voltage|type}:
  PWR_24V|input|"24V"|null
  PWR_GND|null|null|ground
  FG|null|null|ground
  DO_S|input|"24V"|null
  DO_COM|null|null|ground

## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# DI X0-X7: 24VDC sink or source; 4.7kΩ impedance; ON ≥15VDC; OFF ≤5VDC
#   Response: OFF→ON 3.5µs; ON→OFF 20µs; max input frequency: 10kHz (X0-X3) / 1kHz (X4-X7) standard
#   X0,X1: HSC up to 20kHz (C235,C236); X2,X3: HSC 20kHz (C237,C238); X4,X5: 10kHz (C239,C240); X6,X7: 10kHz (C241,C242)
# DO Y0-Y3: PNP transistor sourcing; 0.3A/pt; 24VDC; response: ON 0.1ms; OFF 0.5ms; leakage <0.1mA; short-circuit protection
#   Y0-Y3: 4 PTO channels (10kHz max); Y0 and Y1: PWM DA output (only DVP-12SS211S)
#   PLSY/PLSR: pulse output; DDRVA/DDRVI: positioning; PWM: pulse-width modulation for DA output
gpio[12|]{pin|type|pwm|int|label|roles}:
  0|digital|false|true|"X0 — Digital Input 0; 24VDC sink or source; ON ≥15VDC; OFF ≤5VDC; 4.7kΩ; OFF→ON 3.5µs; ON→OFF 20µs; max 10kHz; HSC C235 channel (20kHz A-phase or single); interrupt input I001/I101; PLC registers address X0 (octal); for high-speed use DO NOT set digital filter"|"di"
  1|digital|false|true|"X1 — Digital Input 1; 24VDC sink/source; 20kHz max; HSC C235 B-phase or C236 A-phase; interrupt I101; 4.7kΩ; 3.5µs/20µs"|"di"
  2|digital|false|true|"X2 — Digital Input 2; 24VDC; 20kHz max; HSC C237 A-phase; interrupt I201"|"di"
  3|digital|false|true|"X3 — Digital Input 3; 24VDC; 20kHz max; HSC C237 B-phase or C238; interrupt I301"|"di"
  4|digital|false|true|"X4 — Digital Input 4; 24VDC; 10kHz max; HSC C239 A-phase; interrupt I401; 1kHz in standard input mode"|"di"
  5|digital|false|true|"X5 — Digital Input 5; 24VDC; 10kHz max; HSC C239 B-phase or C240; interrupt I501; 1kHz standard"|"di"
  6|digital|false|true|"X6 — Digital Input 6; 24VDC; 10kHz max; HSC C241 A-phase; interrupt I601; 1kHz standard"|"di"
  7|digital|false|true|"X7 — Digital Input 7; 24VDC; 10kHz max; HSC C241 B-phase or C242; interrupt I701; 1kHz standard; last built-in DI; total 8 HSC channels: 4×C235-C238@20kHz + 4×C239-C242@10kHz = 8 sets 32-bit HSC counters"|"di"
  8|digital|true|false|"Y0 — Transistor Output 0 PNP (sourcing); 0.3A/24VDC; ON response 0.1ms; OFF response 0.5ms; leakage <0.1mA; residual voltage <1.5VDC; short-circuit protection; PTO channel 0: 10kHz max 32-bit pulse PLSY/PLSR/DDRVA/DDRVI; PWM DA output channel 0 (only DVP-12SS211S); use API57 PWM for analog output via RC filter circuit 100Ω+100µF = 0-10VDC equivalent"|"do"
  9|digital|true|false|"Y1 — Transistor Output 1 PNP; 0.3A; PTO channel 1: 10kHz 32-bit pulse; PWM DA output channel 1 (only DVP-12SS211S); same specs as Y0; direction output for Y0 PTO in DDRVA/DDRVI dual-axis mode"|"do"
  10|digital|true|false|"Y2 — Transistor Output 2 PNP; 0.3A; PTO channel 2: 10kHz 32-bit pulse; no PWM DA (Y2/Y3 do not support DA); use PLSY/PLSR for pulse-only output; same electrical specs as Y0"|"do"
  11|digital|true|false|"Y3 — Transistor Output 3 PNP; 0.3A; PTO channel 3: 10kHz 32-bit pulse; last built-in DO; 4 PTO channels total (Y0-Y3); max pulse output frequency 10kHz per channel; 32-bit total count; short-circuit protection; isolation: transistor output to internal logic 500VAC"|"do"

