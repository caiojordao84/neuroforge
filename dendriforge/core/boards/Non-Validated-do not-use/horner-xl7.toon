## 6. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "4000mA"
  total_current_limit: "5000mA"
  warnings[5]:
    - "Class 2 power supply required for UL compliance"
    - "Digital outputs must be supplied from the same source as the OCS unit"
    - "Battery-backed retentive memory (32KB) — loss of battery loses retained registers"
    - "Integrated 7-inch resistive touchscreen HMI (800x480 WVGA 65K colors)"
    - "Dual CAN ports — CAN1 dedicated CsCAN; CAN2 configurable as CANopen or DeviceNet"
compatibility:
  standard: "IEC 61131-3"
  ide: "Cscape 10.x"
  runtime: "XL7 OCS Firmware"
  languages: "LD;FBD;ST;IL;SFC"

