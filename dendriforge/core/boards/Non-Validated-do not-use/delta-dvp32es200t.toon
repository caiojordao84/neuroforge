  "%IX1.5"|input|"X15 (24V DC Sink/Source, 60Hz)"|di
  "%IX1.6"|input|"X16 (24V DC Sink/Source, 60Hz)"|di
  "%IX1.7"|input|"X17 (24V DC Sink/Source, 60Hz)"|di
  "%QX0.0"|output|"Y0 (NPN transistor 30VDC/0.5A, 100kHz PTO)"|"do;fast-counter"
  "%QX0.1"|output|"Y1 (NPN transistor 30VDC/0.5A, 100kHz PTO)"|"do;fast-counter"
