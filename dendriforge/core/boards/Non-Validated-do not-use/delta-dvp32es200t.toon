## 6. PERIPHERALS & PROTOCOLS:
# Format: peripheral | param | value
peripherals[4|]{peripheral|param|value}:
  serial|"baud:115200"|"proto:Modbus-ASCII/RTU;bus:RS232;port:COM1;role:master-slave"
  serial2|"baud:921600"|"proto:Modbus-ASCII/RTU;bus:RS485;port:COM2;role:master-slave"
  serial3|"baud:115200"|"proto:Modbus-ASCII/RTU;bus:RS485;port:COM3;role:master-slave"
  clock|"resolution:1s"|"type:RTC;fields:YY-MM-DD-WD-HH-MM-SS"
usb:
  type: null
  chip: null
  vid: null
  pid: null

## 7. RACKS & EXPANSION:
# Format: rack | slots | backplane_current | voltage
racks[1|]{rack|slots|backplane_current|voltage}:
  0|8|1200mA|5V
expansion:
  max_signal_modules: 8
  max_communication_modules: 0
  max_signal_boards: 0

## 8. RESTRICTIONS & COMPATIBILITY:
restrictions:
  supply_voltage: 100V
  supply_current_max: 1500mA
  io_output_current_max: 500mA
  sensor_supply_current: 400mA
  operating_temp: "0-55°C"
  storage_temp: "-25-70°C"
  protection_class: IP20
  warnings[9]:
    - "NO USB port on DVP32ES200T; programming via COM1 RS-232 using IFD6530 or USB-RS232 adapter (FTDI-based)"
    - "I/O addresses use Delta octal notation: X0-X7 (8pts), X10-X17 (8pts) = 16 DI; Y0-Y7 + Y10-Y17 = 16 DO"
    - "X0-X3 support 100kHz high-speed counting (HSC); X4-X7 support 10kHz; remaining inputs at 60Hz max"
    - "Y0-Y3 support 100kHz PTO/PWM pulse output (2-axis independent); Y4+ are standard 60Hz switching"
    - "DO outputs are NPN transistor (sink); load must provide +V — NOT PNP sourcing"
    - "Max 256 total I/O with expansion modules (octal X0-X377 / Y0-Y377) but limited by 16 Y if X=256 full"
    - "Supply is 100-240V AC; internal 24V DC sensor supply provided on +24V terminal (limited current)"
    - "Add -E suffix (DVP32ES200TE) for Ethernet port (10/100 Mbps, Modbus TCP + email + web server)"
    - "WPLSoft programming is COM-port based RS-232; set 9600-8-E-1 (Modbus ASCII) for default connection"
compatibility:
  standard: "IEC 61131-3"
  ide: "WPLSoft v2.x / ISPSoft v3.x"
  runtime: "DVP-ES2 FW3.x"
  firmware: "3.x"
  languages: "LD;IL;SFC"
  order_ref: "DVP32ES200T"

