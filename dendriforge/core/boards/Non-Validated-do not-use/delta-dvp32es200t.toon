## 1. DEVICE IDENTIFICATION:
id: delta-dvp32es200t
name: "Delta DVP32ES200T — DVP-ES2 Series Compact PLC (16DI + 16DO-T, AC)"
manufacturer: "Delta Electronics"
cpu: "Delta DVP-ES2 32-bit CPU, 0.54µs/LD instruction"
category: plc
form_factor: compact
standard: "IEC 61131-3"
image: delta-dvp32es200t.svg
url: "https://www.delta-emea.com/en-gb/products/PLC-Programmable-Logic-Controllers/DVP-ES2-EX2"

## 2. TECH SPECS & DIMENSIONS:
specs:
  cycle_time: 1
  memory_work: 20KB
  memory_load: 64KB
  memory_retain: 4KB
  supply_voltage: 100V
  power_consumption: 30W
  di_integrated: 16
  do_integrated: 16
  ai_integrated: 0
dims:
  w: 165.0
  h: 90.0
  t: 85.0

## 3. ELECTRICAL PROFILE (POWER SUPPLY):
# Format: name | direction | voltage | type
powerSupply[4|]{name|direction|voltage|type}:
  L|input|100V|supply
  N|input|null|neutral
  PE|input|null|protective-earth
  SENSOR_SUPPLY|output|24V|sensor-power

## 4. I/O MODULE MAP:
# Format: slot | rack | type | channels | addr_start | addr_end | current
ioModules[3|]{slot|rack|type|channels|addr_start|addr_end|current}:
  0|0|DI|16|"%IX0.0"|"%IX1.7"|null
  1|0|DO|16|"%QX0.0"|"%QX1.7"|null
  2|0|mixed|0|null|null|null

## 5. DIGITAL CHANNEL DESCRIPTORS:
# Format: addr | direction | label | roles
# Delta uses octal X/Y: X0-X7 = %IX0.0-%IX0.7; X10-X17 = %IX1.0-%IX1.7
# Y0-Y7 = %QX0.0-%QX0.7; Y10-Y17 = %QX1.0-%QX1.7
digitalChannels[32|]{addr|direction|label|roles}:
  "%IX0.0"|input|"X0 (24V DC Sink/Source, 100kHz HSC)"|"di;hsc"
  "%IX0.1"|input|"X1 (24V DC Sink/Source, 100kHz HSC)"|"di;hsc"
