## 5. PERIPHERALS & USB:
# Format: peripheral | param | value
peripherals[11|]{peripheral|param|value}:
  usb_device|"speed:12Mbit"|"proto:USB1.1-FullSpeed-device;modes:Serial-MIDI-HID-RawHID-MTP-Keyboard-Mouse-Joystick-Audio-FlightSim-Touchscreen;connector:Micro-B;bootloader:HalfKay-separate-chip"
  usb_host|"speed:480Mbit"|"proto:USB2.0-HighSpeed-OTG-host;independent-of-device-port;pads:D+D-5VGND-bottom;lib:USBHost_t36;hubs-supported;requires-150uF-bypass-cap"
  uart_serial12|"baud:1000000"|"serial1:TX=pin1,RX=pin0,FIFO+HiResBaud;serial2:TX=pin10,RX=pin9,FIFO+HiResBaud"
  uart_serial3456|"baud:1000000"|"serial3:TX=8,RX=7;serial4:TX=32,RX=31(back);serial5:TX=34,RX=33(back);serial6:TX=48,RX=47(back-A23-A24)"
  spi0|"speed:30Mbit"|"sck:pin13;mosi:pin11;miso:pin12;cs:pin10;FIFO:yes;proto:SPI"
  spi12|"speed:30Mbit"|"spi1:SCK=32,MOSI=0,MISO=1,CS=31(back),no-FIFO;spi2:SCK=46,MOSI=44,MISO=45,CS=43(back),no-FIFO"
  i2c_wire0123|"speed:1000kHz"|"wire0:SDA=18,SCL=19;wire1:SDA=38,SCL=37(alt:SDA=17,SCL=16);wire2:SDA=4,SCL=3;wire3:SDA=44,SCL=45(back);all:100-400-1000kHz"
  can_dual|"speed:1Mbit"|"can0:TX=pin3,RX=pin4;can1:TX=pin32,RX=pin33(back);proto:FlexCAN-CAN2.0B;lib:FlexCAN-Teensyduino;requires-external-TJA1050-transceiver-per-bus"
  i2s_audio|"channels:4"|"I2S-TDM:4ch-in+4ch-out;LRCLK:pin23;BCLK:pin9;MCLK:pin28;DOUT:pin22;DIN:pin13;TDM:up-to-16ch;SPDIF-TX:supported;lib:PJRC-Audio-Library"
  sdio_sd|"bits:4"|"proto:native-SDIO-4bit;socket:on-board-built-in;SD.begin(BUILTIN_SDCARD);speed:up-to-20MB-per-s;pads:pins58-63-usable-as-GPIO-without-card"
  ethernet_mac|"speed:100Mbit"|"MAC:built-in-hardware;requires-external-PHY-shield;shields:WIZ820io-W5500-LAN8720;lib:QNEthernet;IEEE1588-timers-4;same-as-3.5"
usb:
  type: Micro-B
  chip: native
  vid: "0x16C0"
  pid: "0x0483"

