## 3. ELECTRICAL PROFILE (POWER PINS):
# Format: name | direction | voltage | type
# Input 3.6..6.0V via VIN or VUSB; LP38691-type LDO → 3.3V 250mA max out
# VUSB and VIN bridged by default — cut bottom solder pad for independent use
powerPins[5|]{name|direction|voltage|type}:
  VIN|input|"5V"|null
  VUSB|input|"5V"|null
  V3V3|output|"3.3V"|null
  AGND|null|null|ground
  GND|null|null|ground

## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# *** CRITICAL: ALL pins are 3.3V ONLY — NO pin is 5V tolerant (unlike Teensy 3.5) ***
# Output: 3.3V, 10mA recommended max; all digital pins support interrupt
# Breadboard-accessible: pins 0-23 front + pins 24-33 front edge (smaller row)
# Back pads: 34-57; SD card pads: 58-63 (usable as GPIO when no card present)
gpio[45|]{pin|type|pwm|int|label|roles}:
  0|digital|false|true|"RX1 / D0 — Serial1 RX (FIFO+HiResBaud); SPI1 MISO (alt); Touch-capable; 3.3V ONLY; interrupt"|"uart-rx;di;do;spi"
  1|digital|false|true|"TX1 / D1 — Serial1 TX (FIFO+HiResBaud); SPI1 MOSI (alt); Touch-capable; 3.3V ONLY; interrupt"|"uart-tx;di;do;spi"
  2|digital|true|true|"D2 / A14 / FTM3-ch0 — PWM FTM3; analog A14; 3.3V ONLY; interrupt"|"di;do;pwm;adc:t"
  3|digital|true|true|"D3 / CAN0-TX / I2C2-SCL / FTM1-ch0 — CAN0 transmit; I2C Wire2 SCL; FTM1 PWM; 3.3V ONLY; interrupt — requires ext TJA1050 transceiver for CAN"|"do;pwm;i2c;can"
  4|digital|false|true|"D4 / CAN0-RX / I2C2-SDA — CAN0 receive; I2C Wire2 SDA; 3.3V ONLY; interrupt"|"di;i2c;can"
  5|digital|true|true|"D5 / PWM FTM0-ch7 — 3.3V ONLY; interrupt"|"di;do;pwm"
  6|digital|true|true|"D6 / PWM FTM0-ch6 — 3.3V ONLY; interrupt"|"di;do;pwm"
