## 6. PERIPHERALS & PROTOCOLS:
# Format: peripheral | param | value
peripherals[6|]{peripheral|param|value}:
  ethernet|"port:502"|"protocol:Modbus-TCP;connections:32+32;speed:100Mbps"
  ethernetip|"port:44818"|"protocol:EtherNet/IP;role:scanner-adapter;cip:32;rpi:5-1000ms"
  serial2|"baud:921600"|"proto:Modbus-ASCII/RTU;bus:RS485;port:COM2;role:master-slave"
  serial3|"baud:921600"|"proto:Modbus-ASCII/RTU;bus:RS485;port:COM3;role:master-slave"
  canopen|"baud:1000"|"role:master;profile:DS301;slaves:64;pdo:2000bytes;card:AS-FCOPM"
  clock|"resolution:1s"|"type:RTC;battery:CR1620;fields:YY-MM-DD-WD-HH-MM-SS"
usb:
  type: Mini-USB
  chip: native
  vid: "0x0346"
  pid: "0x0100"

## 7. RACKS & EXPANSION:
# Format: rack | slots | backplane_current | voltage
racks[2|]{rack|slots|backplane_current|voltage}:
  0|32|2000mA|24V
  1|8|1000mA|24V
expansion:
  max_signal_modules: 32
  max_communication_modules: 4
  max_signal_boards: 2

## 8. RESTRICTIONS & COMPATIBILITY:
restrictions:
  supply_voltage: 24V
  supply_current_max: 2000mA
  io_output_current_max: 500mA
  sensor_supply_current: 500mA
  operating_temp: "-20-60°C"
  storage_temp: "-40-80°C"
  protection_class: IP20
  warnings[9]:
    - "AS332T-A requires 24VDC supply via AS-PS02 or AS-PS02A power module (100-240VAC input); not directly mains-powered"
    - "CANopen DS301 motion (up to 8 axes via AS-FCOPM) requires the AS-FCOPM function card in slot 2; not built-in on AS300"
    - "AS300 supports 2 function card slots; AS-FCOPM occupies slot 2; slot 1 can host AS-F232/F485/F2AD/F2DA/FEN02"
    - "Data backup is battery-free: Flash ROM (program, 100k writes) and MRAM (latched area, unlimited) — no backup battery needed"
    - "RTC requires CR1620 lithium button battery for timekeeping only — separate from data backup"
    - "Expansion I/O uses parallel AS industrial bus (not serial) — I/O update stays ~0.1ms per module regardless of chain length"
    - "Max 32 expansion modules: up to 16 analog modules and 4 communication modules within that total"
    - "Max 15 remote I/O racks via AS00SCM-A in RTU mode + AS-FEN02; total system I/O up to 1024 digital points"
    - "ISPSoft is free; EIP Builder, CANopen Builder and SCMSoft are all free tools available from Delta Download Center"
compatibility:
  standard: "IEC 61131-3"
  ide: "ISPSoft v3.x (free)"
  runtime: "AS300 FW"
  firmware: "3.x"
  languages: "LD;ST;CFC;SFC;C"
  order_ref: "AS332T-A"

