## 1. DEVICE IDENTIFICATION:
id: delta-as332t-a
name: "Delta AS332T-A — AS300 Series Compact Modular PLC (16DI + 16DO-T NPN, 24VDC)"
manufacturer: "Delta Electronics"
cpu: "Delta SoC 32-bit, 400MHz, 25ns/LD, 40k steps/ms"
category: plc
form_factor: modular
standard: "IEC 61131-3"
image: delta-as332t-a.svg
url: "https://www.delta-emea.com/en-gb/products/PLC-Programmable-Logic-Controllers/AS300"

## 2. TECH SPECS & DIMENSIONS:
specs:
  cycle_time: 1
  memory_work: 128KB
  memory_load: 512KB
  memory_retain: 64KB
  supply_voltage: 24V
  power_consumption: 4W
  di_integrated: 16
  do_integrated: 16
  ai_integrated: 0
dims:
  w: 115.0
  h: 88.0
  t: 78.0

## 3. ELECTRICAL PROFILE (POWER SUPPLY):
# Format: name | direction | voltage | type
powerSupply[4|]{name|direction|voltage|type}:
  L+|input|24V|supply
  M|input|null|ground
  PE|input|null|protective-earth
  SENSOR_SUPPLY|output|24V|sensor-power

## 4. I/O MODULE MAP:
# Format: slot | rack | type | channels | addr_start | addr_end | current
ioModules[3|]{slot|rack|type|channels|addr_start|addr_end|current}:
  0|0|DI|16|"%IX0.0"|"%IX0.15"|null
  1|0|DO|16|"%QX0.0"|"%QX0.15"|null
  2|0|mixed|0|null|null|null

## 5. DIGITAL CHANNEL DESCRIPTORS:
# Format: addr | direction | label | roles
# AS300 uses X/Y decimal dotted: X0.0-X0.15 / Y0.0-Y0.15 (16 per word boundary)
digitalChannels[32|]{addr|direction|label|roles}:
  "%IX0.0"|input|"X0.0 (5-24VDC, 200kHz HSC ch0)"|"di;hsc"
