ioModules[0|]{slot|rack|type|channels|addr_start|addr_end|current}:

## 5. PERIPHERALS & PROTOCOLS:
# Format: peripheral | param | value
peripherals[4|]{peripheral|param|value}:
  ethernet|"port:851"|"proto:EtherCAT-Master;ADS"
