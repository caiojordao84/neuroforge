  pid: null

## 6. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "10mA"
  total_current_limit: "100mA"
  warnings[9]:
    - "NO onboard USB; programming and debugging require an external E1/E2/E2 Lite emulator via 14-pin connector"
    - "Board operates at 2.7-5.5V with 20MHz crystal; 3.3V and 5V both supported"
    - "RL78/L13 is a 16-bit MCU with RL78 core — NOT ARM; Arduino framework is NOT supported"
    - "LCD controller drives COM/SEG pins on P3x-P7x; these are NOT general-purpose GPIO"
    - "P16/P17 are multiplexed between UART1 (RXD1/TXD1) and IIC0 (SDA0/SCL0); use one at a time"
    - "P20-P27 are multiplexed between ADC (AIN0-AIN7) and CSI10 (SPI); use one at a time"
    - "All 80 MCU pins are exposed on peripheral board connectors (2x22 headers)"
    - "20MHz resonator is main clock; 32.768kHz crystal for RTC also mounted"
    - "TOOL0 pin is shared between programming/debug and normal GPIO — used by E1/E2 during debug"
compatibility:
  arduinoCore: null
  pio: null
  frameworks: renesas-fsp
  languages: c-rl78
  bootloader: null

