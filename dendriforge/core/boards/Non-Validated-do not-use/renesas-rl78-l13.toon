## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# Encoding: port*10 + bit (P0.0=0, P1.3=13, P2.0=20, etc.)
gpio[22|]{pin|type|pwm|int|label|roles}:
  0|digital|false|true|"P00 / SCL1 (IICA1)"|i2c-scl
  1|digital|false|true|"P01 / SDA1 (IICA1)"|i2c-sda
  10|digital|false|true|"P10 / SI00 (CSI00)"|spi-miso
  11|digital|false|true|"P11 / SO00 (CSI00)"|spi-mosi
  12|digital|false|true|"P12 / SCK00 (CSI00)"|spi-sck
  13|digital|false|true|"P13 / TXD0 (UART0) / AIN8"|uart-tx
  14|digital|false|true|"P14 / RXD0 (UART0) / AIN9"|uart-rx
  15|digital|false|true|"P15 / TO01 (Timer)"|null
  16|digital|false|true|"P16 / RXD1 / SDA0 (IICA0)"|"uart-rx;i2c-sda"
  17|digital|false|true|"P17 / TXD1 / SCL0 (IICA0)"|"uart-tx;i2c-scl"
  20|analog|false|true|"P20 / AIN0 / SO10 (CSI10)"|"adc:t;spi-mosi"
  21|analog|false|true|"P21 / AIN1 / SI10 (CSI10)"|"adc:t;spi-miso"
  22|analog|false|true|"P22 / AIN2 / SCK10 (CSI10)"|"adc:t;spi-sck"
  23|analog|false|true|"P23 / AIN3"|"adc:t"
  24|analog|false|true|"P24 / AIN4"|"adc:t"
  25|analog|false|true|"P25 / AIN5"|"adc:t"
  26|analog|false|true|"P26 / AIN6"|"adc:t"
  27|analog|false|true|"P27 / AIN7"|"adc:t"
  30|digital|false|true|"P30 / INTP0"|null
  31|digital|false|true|"P31 / INTP1"|null
  40|digital|true|false|"P40 / TO00 (TAU PWM)"|null
  50|digital|false|true|"P50 / INTP5"|null

## 5. PERIPHERALS & USB:
# Format: peripheral | param | value
peripherals[4|]{peripheral|param|value}:
  serial|"uarts:3"|"pins:13,14"
  i2c|"channels:3"|"sda:1;scl:0"
  spi|"channels:2"|"miso:10;mosi:11;sck:12;ss:null"
  adc|"resolution:10bit"|"pins:20;21;22;23;24;25;26;27"
usb:
  type: null
