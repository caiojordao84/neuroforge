## 3. ELECTRICAL PROFILE (POWER PINS):
# Format: name | direction | voltage | type
# BMEP582040 has NO external power connector — powered entirely via M580 rack backplane
# Rack power supplied by separate BME/BMX power supply module: BMXPSP0400 (24VDC) or BMXPSP0600 (115-230VAC)
# CPU current consumption from backplane: 270mA @ 24VDC
# Isolation: service ETH port isolated from CPU logic; device network ETH isolated (transformer coupled)
# PE: chassis earth via rack mounting; rack must be grounded to panel earth ≤1Ω
powerPins[4|]{name|direction|voltage|type}:
  BACKPLANE_24V|input|"24V"|null
  BACKPLANE_5V|input|"5V"|null
  BACKPLANE_GND|null|null|ground
  PE_RACK|null|null|ground

## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# BMEP582040 has NO integrated field I/O — no DI/DO/AI/AO on the CPU module itself
# All field I/O via BME/BMX X80 I/O modules in local rack (max 4 racks, 2048 DI/DO, 512 AI/AO)
# Remote I/O via BMENOC EtherNet/IP RIO module + X80 remote racks (8 RIO drops, 2 racks/drop)
# Distributed I/O via EtherNet/IP or Modbus TCP adapters on device network (max 64 devices)
# GPIO map covers the physical communication ports on the CPU front panel
gpio[3|]{pin|type|pwm|int|label|roles}:
  0|digital|false|false|"ETH SERVICE — RJ45; 10BASE-T/100BASE-TX; isolated; dedicated programming and maintenance port; use for EcoStruxure Control Expert (Unity Pro) online connection, firmware update, diagnostics; do NOT use for runtime I/O or SCADA; IP address independent of device network ports; isolation transformer-coupled; LED ETH-MS (green/red)"|"do;di"
  1|digital|false|false|"ETH DEVICE NET PORT 1 — RJ45; 10BASE-T/100BASE-TX; embedded 2-port switch with port 2; protocols: Modbus-TCP-server-client, EtherNet/IP-scanner-adapter, SNMP, DHCP, NTP, TFTP, FTP, HTTP; max 64 concurrent connections; 61 Ethernet devices total on device network; RIO-scanner (8 remote drops); DIO-scanner (64 distributed I/O devices); Global Data; transformer-coupled; LED ETH-NS (green/red)"|"do;di"
  2|digital|false|false|"ETH DEVICE NET PORT 2 — RJ45; same 2-port switch as port 1; same IP address as port 1; use for daisy-chain or star topology; supports RSTP (Rapid Spanning Tree Protocol) for redundant ring topology with BMENOC modules; max cable 100m copper Cat5e or better"|"do;di"

