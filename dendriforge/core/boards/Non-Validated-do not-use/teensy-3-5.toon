## 3. ELECTRICAL PROFILE (POWER PINS):
# Format: name | direction | voltage | type
# Input 3.6..6.0V via VIN or VUSB; LP38691-type LDO → 3.3V 250mA max out
# VUSB/VIN bridged by default; cut back-pad solder jumper for independent operation
powerPins[5|]{name|direction|voltage|type}:
  VIN|input|"5V"|null
  VUSB|input|"5V"|null
  V3V3|output|"3.3V"|null
  AGND|null|null|ground
  GND|null|null|ground

## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# ALL 58 digital I/O pins are 5V tolerant — EXCEPT analog-only pins A10,A11,A21,A22,A25,A26 = 3.3V max!
# Output: 3.3V, 10mA max per pin; all digital pins support pin-change interrupt
# Breadboard pins: 0-33 (front edges); back pads: 34-63 (bottom side)
gpio[42|]{pin|type|pwm|int|label|roles}:
  0|digital|false|true|"RX1 / D0 — Serial1 RX (FIFO); SPI1 MISO (alt); 5V-tolerant; interrupt"|"uart-rx;di;do;spi"
  1|digital|false|true|"TX1 / D1 — Serial1 TX (FIFO); SPI1 MOSI (alt); 5V-tolerant; interrupt"|"uart-tx;di;do;spi"
  2|digital|true|true|"D2 / A14 / FTM3-ch0 — digital I/O; analog A14; PWM FTM3; 5V-tolerant; interrupt"|"di;do;pwm;adc:t"
  3|digital|true|true|"D3 / CAN-TX / I2C2-SCL / FTM1 — FlexCAN TX; I2C Wire2 SCL; PWM FTM1 ch0; 5V-tolerant; interrupt; requires ext TJA1050 transceiver for CAN"|"do;pwm;i2c;can"
  4|digital|false|true|"D4 / CAN-RX / I2C2-SDA — FlexCAN RX; I2C Wire2 SDA; 5V-tolerant; interrupt"|"di;i2c;can"
  5|digital|true|true|"D5 / PWM FTM0-ch7 — 5V-tolerant; interrupt"|"di;do;pwm"
  6|digital|true|true|"D6 / PWM FTM0-ch6 — 5V-tolerant; interrupt"|"di;do;pwm"
  7|digital|false|true|"D7 / RX3 — Serial3 RX; 5V-tolerant; interrupt"|"uart-rx;di;do"
  8|digital|false|true|"D8 / TX3 — Serial3 TX; 5V-tolerant; interrupt"|"uart-tx;di;do"
  9|digital|true|true|"D9 / RX2 / PWM FTM0-ch5 — Serial2 RX (FIFO+HiResBaud); PWM; 5V-tolerant; interrupt"|"uart-rx;di;do;pwm"
  10|digital|true|true|"D10 / TX2 / CS0 / PWM FTM0-ch4 — Serial2 TX (FIFO+HiResBaud); SPI0 CS; PWM; 5V-tolerant; interrupt"|"uart-tx;do;pwm;spi"
  11|digital|false|true|"D11 / MOSI / SPI0 — SPI0 MOSI (default, with FIFO); 5V-tolerant; interrupt"|"di;do;spi"
  12|digital|false|true|"D12 / MISO / SPI0 — SPI0 MISO (default); 5V-tolerant; interrupt"|"di;spi"
  13|digital|true|true|"D13 / SCK / LED — SPI0 SCK (default, FIFO); on-board LED (orange); I2S DIN; 5V-tolerant; interrupt — LED shares pin; do NOT apply >5mA to LED without resistor"|"di;do;pwm;spi"
  14|analog|false|true|"A0 / D14 — ADC0 analog; digital I/O; 5V-tolerant; interrupt"|"di;do;adc:t"
  15|analog|false|true|"A1 / D15 — ADC0 analog; digital I/O; 5V-tolerant; interrupt"|"di;do;adc:t"
