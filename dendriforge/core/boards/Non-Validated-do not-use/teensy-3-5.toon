## 5. PERIPHERALS & USB:
# Format: peripheral | param | value
peripherals[10|]{peripheral|param|value}:
  usb_fullspeed|"speed:12Mbit"|"proto:USB1.1-FullSpeed;modes:Serial-MIDI-HID-RawHID-MTP-Keyboard-Mouse-Joystick-Audio-FlightSim-Touchscreen;DMA:dedicated;connector:Micro-B;bootloader:HalfKay-separate-chip"
  uart_serial12|"baud:1000000"|"serial1:TX=pin1,RX=pin0,FIFO+HiResBaud;serial2:TX=pin10,RX=pin9,FIFO+HiResBaud"
  uart_serial3456|"baud:1000000"|"serial3:TX=8,RX=7;serial4:TX=32,RX=31(back);serial5:TX=34,RX=33(back);serial6:TX=48,RX=47(back)"
  spi0|"speed:30Mbit"|"sck:pin13;mosi:pin11;miso:pin12;cs:pin10;FIFO:yes;proto:SPI"
  spi12|"speed:30Mbit"|"spi1:CS=31,SCK=32,MOSI=0,MISO=1(back);spi2:CS=43,SCK=46,MOSI=44,MISO=45(back);no-FIFO"
  i2c_wire012|"speed:1000kHz"|"wire0:SDA=18,SCL=19;wire1:SDA=38,SCL=37(alt:SDA=17,SCL=16);wire2:SDA=4,SCL=3;all-support-100-400-1000kHz"
  can_flexcan|"speed:1Mbit"|"tx:pin3;rx:pin4;proto:FlexCAN-CAN2.0B;lib:FlexCAN-Teensyduino;requires-external-TJA1050-transceiver"
  i2s_audio|"channels:4"|"I2S-TDM:4ch-in+4ch-out;LRCLK:pin23-or-25;BCLK:pin9-or-26;MCLK:pin28;DOUT:pin22;DIN:pin13;TDM:up-to-16ch;lib:PJRC-Audio-Library"
  sdio_sd|"bits:4"|"proto:native-SDIO-4bit;socket:on-board-built-in;SD.begin(BUILTIN_SDCARD);speed:up-to-20MB-per-s;SPI-also-supported-via-SD.begin(cspin)"
  ethernet_mac|"speed:100Mbit"|"MAC:built-in-hardware;requires-external-PHY-shield;shields:WIZ820io-W5500-LAN8720;lib:QNEthernet-or-Ethernet;IEEE1588-timers-4"
usb:
  type: Micro-B
  chip: native
  vid: "0x16C0"
  pid: "0x0483"

## 6. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "10mA"
  total_current_limit: "250mA"
  warnings[9]:
    - "Analog-only pins A10 (D40), A11 (D41), A21 (DAC0), A22 (DAC1), A25, A26 are 3.3V ONLY and NOT 5V tolerant — all other digital/analog pins are 5V tolerant; applying 5V to analog-only pins will permanently damage the MK64FX512"
    - "CAN bus requires an EXTERNAL transceiver (TJA1050 or MCP2551) between pin3/pin4 and the CAN bus — without it the FlexCAN port provides only logic-level signals; do not connect directly to automotive or industrial CAN bus wiring"
    - "Ethernet MAC is built-in but requires an external PHY shield (WIZ820io, W5500, or LAN8720) — without the PHY chip, no Ethernet communication is possible; the Ethernet MAC supports 10/100Mbps with dedicated DMA"
    - "Teensy 3.5 is DISCONTINUED (last batch Aug 2023, out of stock as of Mar 2025) — PJRC recommends migrating to Teensy 4.1 for new designs; the MK64FX512 chip supply will continue to dwindle due to 90nm process limitations"
    - "VUSB and VIN are bridged by default — cut the bottom-side solder pads before using an external battery charger or power supply simultaneously with USB; failure to cut may back-drive the USB host or damage the regulator"
    - "SPI ports 1 and 2 (SPI1, SPI2) use back-pad pins (32, 31, 0, 1 for SPI1; 43, 46, 44, 45 for SPI2) — these are only accessible by soldering wires directly to the bottom pads; they are NOT breadboard accessible"
    - "The built-in SD card socket uses 4-bit SDIO (SD.begin(BUILTIN_SDCARD)) — this is fast (up to 20 MB/s) but SDIO pins are shared with I2S audio and Serial4/5; do NOT use SD and I2S audio simultaneously without careful pin conflict checking"
    - "I2S/TDM audio pins overlap with SPI0 (pin13=SCK), Serial2 (pin9/10), and Serial3 (pin7/8) — the PJRC Audio Library reconfigures affected pins when audio objects are instantiated; do NOT simultaneously use conflicting hardware"
    - "RTC 32.768 kHz crystal is pre-soldered on Teensy 3.5 PCB (unlike Teensy 3.2 which requires hand-soldering) — however VBAT coin cell (CR2032) is still user-provided; without VBAT the RTC loses time when power is removed"
compatibility:
  sw: "Arduino IDE + Teensy boards add-on (Boards Manager install); PlatformIO (teensy35 target); Visual Micro; Makefile"
  languages: "C++;C;Arduino (C++ subset);ARM assembly"
  frameworks: "Teensyduino;PJRC Audio Library;FlexCAN lib;Wire;SPI;SD;EEPROM;QNEthernet;OctoWS2811;SmartMatrix;IntervalTimer"
  certifications: "FCC-Part15-ClassB;CE;RoHS"

