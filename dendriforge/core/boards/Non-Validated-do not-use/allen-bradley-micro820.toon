## 6. ANALOG CHANNEL DESCRIPTORS:
# Format: addr | direction | resolution | range | label
analogChannels[5|]{addr|direction|resolution|range|label}:
  "%IW0"|input|12|"0-10V"|"AI 0"
  "%IW2"|input|12|"0-10V"|"AI 1"
  "%IW4"|input|12|"0-10V"|"AI 2"
  "%IW6"|input|12|"0-10V"|"AI 3"
  "%QW0"|output|12|"0-10V"|"AO 0"

## 7. PERIPHERALS & PROTOCOLS:
# Format: peripheral | param | value
peripherals[5|]{peripheral|param|value}:
  ethernet|"port:44818"|"proto:EtherNet/IP;speed:10-100Mbps"
  modbus-tcp|"port:502"|"role:server"
  ethernetip|"port:44818"|"max_nodes:20"
  serial|"baud:38400"|"proto:RS232;RS485"
  opc-ua|"port:4840"|null
service:
  type: USB
  connector: "USB-B"
  protocol: "programming-only"

## 8. RACKS & EXPANSION:
# Format: rack | slots | backplane_current | voltage
racks[1|]{rack|slots|backplane_current|voltage}:
  0|2|800mA|24V
expansion:
  max_plugin_modules: 2
  microsd_slot: true
  remote_lcd: "2080-REMLCD"

## 9. RESTRICTIONS & COMPATIBILITY:
restrictions:
  supply_voltage: 24V
  operating_temp_min: "-20°C"
  operating_temp_max: "65°C"
  storage_temp_min: "-40°C"
  storage_temp_max: "85°C"
  humidity_max: "95%RH"
  protection_class: IP20
  warnings[3]:
    - "Digital outputs are relay type (NO); rated 125V DC / 250V AC"
    - "RS232 and RS485 share the same physical port; only one active at a time"
    - "Analog inputs support 0-10V DC; use plug-in module for 4-20mA or thermocouple"
compatibility:
  standard: "IEC 61131-3"
  ide: "Connected Components Workbench v21"
  runtime: "Micro820 FW8.x"
  firmware: "8.x"
  languages: "LD;FBD;ST;SFC"
  order_ref: "2080-LC20-20QWB"

