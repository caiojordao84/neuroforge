## 3. ELECTRICAL PROFILE (POWER PINS):
# Format: name | direction | voltage | type
# NX1P2-9024DT1: 24VDC (20.4-28.8VDC); 6.40W power consumption; inrush 10A/0.1ms + 2.5A/150ms cold start
# NX bus power capacity: 10W max (for NX units on CPU rack right side); efficiency 80%
# I/O power supply: NOT provided by CPU — NX-PF0630 or NX-PF0730 Additional I/O Power Supply Unit required
#   for most NX DI/DO/AI/AO units (see NX power supply table in official datasheet)
# Isolation: NO isolation between 24VDC supply terminal and internal CPU circuit
# Grounding: Class D (<100Ω) required; connect to panel earth via FG terminal
# Terminal current capacity: 4A max continuous per power terminal (through-wiring)
powerPins[4|]{name|direction|voltage|type}:
  PWR_24V|input|"24V"|null
  PWR_0V|null|null|ground
  FG|null|null|ground
  NX_BUS_PWR|output|"24V"|null

## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# DI: 14 points 24VDC PNP/NPN sink/source; screwless clamping terminal block (removable)
#   ON: ≥15VDC; OFF: ≤5VDC; response: 20µs ON / 400µs OFF standard; 4mA@24VDC
#   No dedicated HSC on built-in I/O — use NX-EC (encoder) or NX-PG (pulse) NX units for high-speed counting
# DO: 10 points PNP transistor (sourcing) 0.5A/point 24VDC; load short-circuit protection; removable terminal block
#   ON: 0.5ms; OFF: 1.0ms; max inrush: 1A peak 10ms; leakage: 0.1mA max; residual voltage: ≤1.5VDC
# IMPORTANT: Output type DT1 = PNP sourcing; sinks on common COM; DO share common COM on terminal block
# NOTE: NX1P2-9024DT1 has 1 option board slot (vs 2 for -1140DT1 variant)
gpio[27|]{pin|type|pwm|int|label|roles}:
  0|digital|false|false|"I00 — Digital Input 0; 24VDC PNP/NPN sink/source; ON ≥15VDC; OFF ≤5VDC; 4mA@24VDC; ON response 20µs; OFF response 400µs; digital filter 0/0.1/0.5/1.0/2.0/4.0ms configurable; screwless clamping terminal block removable; no HSC on built-in inputs — use NX-EC/NX-PG NX units for encoder/pulse input"|"di"
  1|digital|false|false|"I01 — Digital Input 1; same as I00; 24VDC PNP/NPN"|"di"
  2|digital|false|false|"I02 — Digital Input 2; 24VDC PNP/NPN; 20µs/400µs"|"di"
