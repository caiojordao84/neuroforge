## 3. ELECTRICAL PROFILE (POWER PINS):
# Format: name | direction | voltage | type
# 3.3V from on-board LDO; powered by ICDI USB or Device USB
# Power switch selects ICDI USB vs Device USB as source
# VBAT pad: connect 3V coin cell for Hibernation RTC when main power off
powerPins[6|]{name|direction|voltage|type}:
  VBUS_ICDI|input|"5V"|null
  VBUS_DEVICE|input|"5V"|null
  V3V3|output|"3.3V"|null
  VBAT|input|"3V"|null
  GND|null|null|ground
  AGND|null|null|ground

## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# ALL GPIO: 3.3V logic ONLY — NOT 5V tolerant; output 8mA max per pin
# TM4C1294NCPDT has ports PA-PQ (up to 90 I/O pins, 128-pin TQFP)
# LaunchPad BoosterPack XL J1-J4 expose the most commonly used pins
# Ports PH, PJ exposed on inner headers; PK-PQ on extension area
gpio[46|]{pin|type|pwm|int|label|roles}:
  0|digital|false|true|"PA0 / UART0-RX / I2C9-SCL / CAN0-RX — UART0 RX (ICDI VCP); I2C9 SCL; CAN0 RX alt; 3.3V ONLY; interrupt"|"uart-rx;di;do;i2c;can"
