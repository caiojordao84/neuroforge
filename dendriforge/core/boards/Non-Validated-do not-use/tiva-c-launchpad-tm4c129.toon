  5|digital|false|true|"PA5 / SSI0-MOSI / UART3-TX / I2C7-SDA — SSI0 TX; UART3 TX; I2C7 SDA; 3.3V ONLY; interrupt"|"di;do;spi;uart-tx;i2c"
