# Format: peripheral | param | value
peripherals[12|]{peripheral|param|value}:
  ethernet_maphy|"speed:100Mbit"|"proto:IEEE802.3-10-100Mbps;MAC+PHY:on-chip-integrated;RMII+MII;IEEE1588v2-PTP;EEE-802.3az;connector:RJ45-on-board-with-magnetics;lib:TivaWare-Ethernet-LwIP;leds:PF0-LED0-PF4-LED1"
  usb_otg|"speed:12Mbit"|"proto:USB2.0-FS+LS-OTG-Host-Device;endpoints:32;connector:Micro-A-B;DM:PL6;DP:PL7;lib:TivaWare-USB;modes:CDC-HID-Bulk-Audio-DFU"
  uart_0to3|"baud:3000000"|"uart0:RX=PA0,TX=PA1(ICDI-VCP);uart1:RX=PB0,TX=PB1,CTS=PB4,RTS=PB5;uart2:RX=PA6,TX=PA7;uart3:RX=PA4,TX=PA5;all:IrDA-9bit-ISO7816"
  uart_4to7|"baud:3000000"|"uart4:RX=PK0,TX=PK1;uart5:RX=PC6,TX=PC7;uart6:RX=PP0,TX=PP1;uart7:RX=PC4,TX=PC5"
  ssi_0to3|"speed:25Mbit"|"ssi0:CLK=PA2,FSS=PA3,RX=PA4,TX=PA5;ssi1:CLK=PB4,FSS=PB5,RX=PE4,TX=PE5(alt);ssi2:CLK=PD3,FSS=PD2,RX=PD0,TX=PD1;ssi3:CLK=PF3,FSS=PF2,RX=PF0,TX=PF1;modes:Freescale-SPI-MICROWIRE-TI-sync"
  i2c_0to9|"speed:3400kHz"|"i2c0:PB2-PB3;i2c1:PG0-PG1;i2c2:PL1-PL0(alt:PN5-PN4);i2c3:PK4-PK5;i2c4:PK6-PK7;i2c5:PB0-PB1;i2c6:PA6-PA7;i2c7:PA4-PA5;i2c8:PA2-PA3;i2c9:PA0-PA1;all:100-400-1000-3400kHz"
  can_0to1|"speed:1Mbit"|"can0:RX=PA0-or-PB4,TX=PA1-or-PB5;can1:RX=PB0,TX=PB1;proto:CAN2.0A-2.0B;requires-external-SN65HVD232-transceiver-per-bus"
  mc_pwm|"channels:8"|"M0PWM0-7:PF0-PF3-PE4-PE5-PG0-PG1;4-generators;dead-band;1x-fault-input;QEI:PL1-PhA-PL2-PhB-PL3-IDX"
  adc_0to1|"resolution:12bit"|"ADC0+ADC1:12-bit-SAR;2MSPS-per-module;20-channels:AIN0-PE3..AIN11-PB5,AIN12-PD3,AIN13-PD2,AIN14-PD1,AIN15-PD0,AIN16-PK0,AIN17-PK1,AIN18-PK2,AIN19-PK3;temp-sensor;16-sample-FIFO"
  hibernation|"current:5uA"|"wake:GPIO-or-RTC;RTC:32768Hz-crystal-on-board;VBAT:coin-cell-pad;GPIORETENTION:supported;lib:TivaWare-Hibernate"
  timers|"count:8"|"8x32bit-GPT(16x16bit);8x64bit-wideGPT(16x32bit);SysTick;2xWatchdog;IEEE1588-PTP-timers-in-ETH"
  epi|"width:32bit"|"EPI:external-parallel-interface;SDRAM-SRAM-FPGAs-LCD-host-bus;up-to-60MHz;pins:PK0-PK7-PH0-PH3-etc"
