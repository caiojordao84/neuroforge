  16|digital|true|true|"PA16 / D11 / PWM (TCC2) / MOSI"|spi-mosi
  19|digital|false|true|"PA19 / D12 / MISO"|spi-miso
  17|digital|false|true|"PA17 / D13 / SCK / LED"|"spi-sck;status-led"
  2|analog|false|true|"PA02 / A0 / AIN0 / DAC0"|"adc:t;dac"
  108|analog|false|true|"PB08 / A1 / AIN2"|"adc:t"
  109|analog|false|true|"PB09 / A2 / AIN3"|"adc:t"
  4|analog|false|true|"PA04 / A3 / AIN4"|"adc:t"
  5|analog|false|true|"PA05 / A4 / AIN5"|"adc:t"
  102|analog|false|true|"PB02 / A5 / AIN10"|"adc:t"
  22|digital|false|true|"PA22 / SDA (SERCOM3)"|i2c-sda
  23|digital|false|true|"PA23 / SCL (SERCOM3)"|i2c-scl

## 5. PERIPHERALS & USB:
# Format: peripheral | param | value
peripherals[5|]{peripheral|param|value}:
  serial|"uarts:2"|"pins:10,11"
  i2c|"channels:6"|"sda:22;scl:23"
  spi|"channels:6"|"miso:19;mosi:16;sck:17;ss:18"
  adc|"resolution:12bit"|"pins:2;108;109;4;5;102"
  dac|"resolution:10bit"|"pins:2"
usb:
  type: Micro-USB
  chip: native
  vid: "0x2341"
  pid: "0x004D"

## 6. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "7mA"
  total_current_limit: "130mA"
  warnings[8]:
    - "All I/O pins operate at 3.3V ONLY — NOT 5V tolerant; connecting 5V signals will damage the MCU"
    - "Two Micro-USB ports: Programming (EDBG, PID 0x804D) and Native (MCU, PID 0x004D); use Programming for IDE"
    - "A0/PA02 is the only pin with true DAC output (10-bit); remaining analog pins are input only"
    - "SERCOM architecture provides up to 6 configurable serial interfaces (UART/SPI/I2C) via pin multiplexing"
    - "No hardware floating-point unit (FPU) — ARM Cortex-M0+ only; use fixed-point math for performance"
    - "D13/PA17 is shared with SPI SCK and onboard LED; avoid SPI and LED simultaneously"
    - "EEPROM: not natively available; use FlashStorage library for emulated EEPROM (writes limited by flash)"
    - "EDBG chip (ATSAMD21J18A) provides SWD debug + USB CDC + virtual COM for programming"
compatibility:
  arduinoCore: "1.8.14"
  pio: samd
  frameworks: arduino
  languages: arduino-cpp
  bootloader: sam-ba-zero

