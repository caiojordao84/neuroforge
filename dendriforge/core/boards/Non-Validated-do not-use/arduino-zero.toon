  8|digital|true|true|"PA08 / D4 / PWM (TCC0)"|null
  15|digital|true|true|"PA15 / D5 / PWM (TCC0)"|null
  20|digital|true|true|"PA20 / D6 / PWM (TCC0)"|null
  21|digital|false|true|"PA21 / D7"|null
  6|digital|false|true|"PA06 / D8"|null
  7|digital|true|true|"PA07 / D9 / PWM (TCC1)"|null
