peripherals[12|]{peripheral|param|value}:
  profinet_x1_irt|"speed:100Mbit"|"interface:X1;ports:2x-RJ45-2-port-switch;mode:IRT-and-RT;sync-cycle:250us-to-4ms;RT-cycle:1ms-min;IO-devices-max:256;topology:line-star-ring-tree-MRP;protocols:PROFINET-IO-ctrl+device,S7-comm,TCP-IP,UDP,ISO-on-TCP-RFC1006,Modbus-TCP-V4plus,OPC-UA-V2.6plus,WebServer,HTTPS,SNMP,DCP,LLDP;IRT-requires-IRT-capable-switches-SCALANCE-X"
  profinet_x2_rt|"speed:100Mbit"|"interface:X2;ports:1x-RJ45;mode:RT-only-no-IRT;IO-devices-max:256-independent-of-X1;use:network-separation-supervisor-DMZ-OPC-UA-separate-segment;protocols:same-as-X1-minus-IRT"
