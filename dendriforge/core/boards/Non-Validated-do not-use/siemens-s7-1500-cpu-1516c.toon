  pid_control|"loops:unlimited"|"PID_Compact:self-tuning-pretuning-fine-tuning;PID_3Step:valve-positioner;PID_Temp:temperature-cascade;sampling-configurable;output:AO-module-or-PWM-via-DO-module"
  webserver|"protocol:HTTPS"|"user-defined-web-pages;standard-diagnostics-pages;CSV-download;variable-access-via-AWP-commands;HTTPS-certificate;accessible-from-X1-and-X2;user-accounts-with-roles"
