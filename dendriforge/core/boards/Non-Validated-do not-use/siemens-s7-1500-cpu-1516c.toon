  memory_card|"size:32GB"|"SIMATIC-Memory-Card-MANDATORY-program-not-stored-in-CPU;types:4MB-12MB-24MB-2GB-4GB-32GB;microSD-based;stores:program-project-firmware-update-data-logs;RTC-backup:maintenance-free-via-card;remove-hot:no-CPU-stops;compatible:all-S7-1500-CPUs"
