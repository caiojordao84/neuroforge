## 3. ELECTRICAL PROFILE (POWER PINS):
# Format: name | direction | voltage | type
# CPU 1516-3 PN/DP does NOT have its own power supply — it draws from S7-1500 system backplane bus
# A separate System Power Supply (PS) module (e.g. 6EP1333-4BA00 PS 25W 24VDC) is MANDATORY on the rail
# Backplane supply: 24VDC, range 19.2-28.8VDC; CPU infeed to bus: 12W; CPU draw from bus: 6.7W (balanced)
# PE: Protective Earth via mounting rail — CPU chassis bonded to rail; rail must be earthed to PE
powerPins[5|]{name|direction|voltage|type}:
  L_PLUS_BACKPLANE|input|"24V"|null
  M_BACKPLANE|null|null|ground
  PE_RAIL|null|null|ground
  INFEED_TO_BUS|output|"24V"|null
  DRAW_FROM_BUS|input|"24V"|null

## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# CPU 1516-3 PN/DP has NO integrated field I/O — all DI, DO, AI, AO via ET 200MP I/O modules on the rail
# or distributed via PROFINET IO devices or PROFIBUS DP slaves
# The GPIO map represents the 3 communication interface connectors on the CPU front face
gpio[3|]{pin|type|pwm|int|label|roles}:
  0|digital|false|false|"X1-P1 / PROFINET IRT port 1 — RJ45; 10/100 Mbps; auto-MDI-X; isolated; part of integrated 2-port switch on X1; supports IRT sync cycle 250µs-4ms; PROFINET IO controller+IO device; up to 256 PROFINET IO devices on X1; protocols: PROFINET-IRT-RT, S7-comm, TCP-IP, UDP, ISO-on-TCP, Modbus-TCP, OPC-UA"|"do;di"
  1|digital|false|false|"X1-P2 / PROFINET IRT port 2 — RJ45; 10/100 Mbps; integrated switch with P1; IRT backbone or star topology; line-bus ring topology possible with MRP; all X1 specs same as P1"|"do;di"
  2|digital|false|false|"X2 / PROFINET RT — RJ45; 10/100 Mbps; 1 port; auto-MDI-X; isolated; standard RT only (no IRT); up to 256 PROFINET IO devices independent of X1; used for network separation (supervisor-level or DMZ); protocols same as X1 minus IRT"|"do;di"

## 5. PERIPHERALS & USB:
