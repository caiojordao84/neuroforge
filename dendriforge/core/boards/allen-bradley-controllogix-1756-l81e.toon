## 3. ELECTRICAL PROFILE (POWER PINS):
# Format: name | direction | voltage | type
# 1756-L81E has NO built-in power supply — requires a separate 1756-PA or 1756-PB power supply module in chassis
# Standard AC supplies: 1756-PA50 (120/240VAC 50W), 1756-PA75 (120/240VAC 75W)
# Standard DC supplies: 1756-PB50 (24VDC 50W), 1756-PB75 (24VDC 75W)
# CPU draws: 1.20A @ 5.1VDC backplane; 2.0mA @ 1.2VDC; total power dissipation 6.2W
# Isolation: 30VDC continuous Basic Insulation — ETH to backplane, USB to backplane, USB to ETH
# ESM (Energy Storage Module): embedded non-removable; maintains RTC after power loss (no user battery)
# PE: Protective Earth via chassis mounting; chassis must be grounded to machine frame / PE
powerPins[5|]{name|direction|voltage|type}:
  BACKPLANE_5V|input|"5V"|null
  BACKPLANE_12V|input|"12V"|null
  BACKPLANE_24V|input|"24V"|null
  BACKPLANE_GND|null|null|ground
  PE_CHASSIS|null|null|ground

## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# 1756-L81E has NO integrated field I/O (no DI, DO, AI, AO on CPU module itself)
# All physical I/O is via 1756 ControlLogix I/O modules in local chassis slots or remote chassis/distributed I/O
# GPIO map represents the physical communication connectors on the CPU front panel
gpio[2|]{pin|type|pwm|int|label|roles}:
  0|digital|false|false|"ETH1 / Gigabit EtherNet/IP — RJ45; 10/100/1000 Mbps auto-MDI-X; isolated 30VDC cont; embedded port; 60 EtherNet/IP nodes on this port alone; total 100 nodes incl. via 1756-ENxT modules; protocols: EtherNet/IP-CIP, CIP-Motion up to 256 axes family-wide, CIP-Security TLS-DTLS, OPC-UA 300 nodes, PCCC-on-EIP, open-socket-TCP-UDP; I/O pkt rate: 28,000pps without CIP Security; wire category 2"|"do;di"
  1|digital|false|false|"USB / Type-A — USB 2.0 Full Speed 12 Mbps; TEMPORARY programming ONLY; NOT for permanent connection; NOT for use in hazardous locations; wire category 3; use: Studio 5000 upload-download, firmware update, online edits; cable max 3m; isolation 30VDC cont Basic Insulation to backplane"|"do;di"

