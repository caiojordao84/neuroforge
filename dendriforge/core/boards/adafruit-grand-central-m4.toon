## 5. PERIPHERALS & USB:
# Format: peripheral | param | value
peripherals[7|]{peripheral|param|value}:
  serial|"uart0:1"|"pins:0,1"
  serial|"uart1:1"|"pins:18,19"
  serial|"uart2:1"|"pins:16,17"
  serial|"uart3:1"|"pins:14,15"
  i2c|"channels:1"|"sda:20;scl:21"
  spi|"channels:1"|"miso:50;mosi:51;sck:52;ss:53"
  dac|"channels:2"|"dac0:54;dac1:55"
usb:
  type: "Micro-USB"
  chip: "ATSAMD51P20A native"
  vid: "0x239A"
  pid: "0x8030"

## 6. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "7mA"
  total_current_limit: "500mA"
  warnings[5]:
    - "Logic level is 3.3V — 5V on any I/O pin causes permanent damage"
    - "Max per-pin sink/source is 7mA; use driver transistors for loads above 7mA"
    - "Arduino Mega shield compatible but some shields expect 5V logic"
    - "SD card slot uses dedicated SPI — shares no pins with header SPI"
    - "Not all D0-D53 header pins are connected to SAMD51 — check datasheet"
compatibility:
  arduinoCore: "1.8.19"
  pio: adafruit
  frameworks: arduino
  languages: arduino-cpp
  bootloader: uf2

