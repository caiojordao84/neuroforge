# METADATA:
project_name: controllino-mega-profile
version: 1
editor: dendriForge
author: schemasmith
ASLversion: 0.1.0

## 1. DEVICE IDENTIFICATION:
id: controllino-mega
name: "Controllino MEGA"
manufacturer: Controllino
cpu: "ATmega2560"
category: plc
form_factor: compact
standard: "IEC 61131-3"
image: controllino-mega.svg
url: "https://controllino.biz/product/controllino-mega/"

## 2. TECH SPECS & DIMENSIONS:
specs:
  cycle_time: 1
  supply_voltage: 24V
  memory_work: 8KB
  memory_load: 256KB
  memory_retain: 4KB
  power_consumption: 3W
  di_integrated: 20
  do_relay_integrated: 14
  do_transistor_integrated: 6
  ai_integrated: 14
  ao_integrated: 2
  rtc: true
  sd_card: true
dims:
  w: 222.0
  h: 103.0
  t: 28.0

## 3. ELECTRICAL PROFILE (POWER SUPPLY):
# Format: name | direction | voltage | type
powerPins[4|]{name|direction|voltage|type}:
  VIN|input|24V|null
  5V|output|"5V"|null
  3V3|output|"3.3V"|null
  GND|null|null|ground

## 4. I/O MODULE MAP:
# Format: slot | rack | type | channels | addr_start | addr_end | current
ioModules[5|]{slot|rack|type|channels|addr_start|addr_end|current}:
  0|0|DI|20|"%IX0.0"|"%IX2.3"|null
  1|0|DO|14|"%QX0.0"|"%QX1.5"|null
  2|0|DO|6|"%QX2.0"|"%QX2.5"|null
  3|0|AI|14|"%IW0"|"%IW13"|null
  4|0|AO|2|"%QW0"|"%QW1"|null

## 5. PERIPHERALS & PROTOCOLS:
# Format: peripheral | param | value
peripherals[5|]{peripheral|param|value}:
  serial|"baud:19200"|"proto:RS485;isolation:galvanic"
  ethernet|"port:80"|"chip:W5500;speed:10-100Mbps"
  modbus-tcp|"port:502"|"address:1;role:server"
  modbus-rtu|"baud:9600"|"address:1;parity:none"
  opc-ua|"port:4840"|"security:none;max_connections:4"
usb:
  type: Mini-USB
  chip: CH340G
  vid: "0x1A86"
  pid: "0x7523"

## 6. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "40mA"
  total_current_limit: "3000mA"
  max_relay_load: "5A"
  max_transistor_load: "0.5A"
  operating_temp: "-20 to 60C"
  protection_class: IP20
  warnings[4]:
    - "Analog outputs are PWM-generated — external low-pass filter required for true analog"
    - "RTC requires CR2032 battery for timekeeping across power cycles"
    - "Maximum simultaneous relay current must not exceed 16A"
    - "Ethernet defaults to DHCP — configure static IP for industrial environments"
compatibility:
  standard: "IEC 61131-3"
  ide: "Arduino IDE 2.x;CODESYS 3.5"
  runtime: "Controllino v3.x"
  languages: "LD;FBD;ST;SFC"

## 7. AGENT SKILLS:
dendriForge:
  boardFamilySkillId: plc-family
  boardProfileId: controllino-mega
  defaultLanguageSkills[4]:
    - ld-iec61131
    - fbd-iec61131
    - st-iec61131
    - sfc-iec61131