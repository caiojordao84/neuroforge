# 6. PERIPHERALS & CONNECTIVITY:
# Format: peripheral | param | value
peripherals[5]:
  - ethernet|ports:2|standard:10/100BaseT|topology:linear,ring,star|protocol:EtherNet/IP,Modbus-TCP,CIP
  - dlr|Device-Level-Ring:t|topology:ring-redundancy|note:all-variants
  - usb|type:USB-A|mode:programming+diagnostics|note:local-only
  - sd-card|slot:t|default:1GB|max:2GB|function:program-save-restore,data-log
  - motion-cip|protocol:CIP-Motion|axes:variant-dependent|kinematics:t|note:ERM-variants-only

# 7. RESTRICTIONS & COMPATIBILITY:
restrictions:
  operating_temp_min: 0C | operating_temp_max: 60C | storage_temp_min: -40C | storage_temp_max: 85C
  protection: IP20 | din_rail: t | panel_mount: t | humidity: 5-95pct-non-condensing
  warnings[6]:
    - No embedded I/O on L1/L3 base models — requires 1769 expansion modules
    - Battery-free design uses capacitor — verify energy hold-up time for application
    - SD card max 2GB — larger cards not supported
    - USB port is local programming only — not for runtime data
    - Safety variants (ERMS/ERMSK) require Compact GuardLogix firmware
    - Conformally coated variants (K suffix) mandatory for harsh environments
compatibility:
  studio5000: v21-or-later | rslogix5000: v21-or-later | firmware: Logix5000
  plc_languages: ladder,fbd,st,sfc,il | iec_standard: IEC-61131-3
  protocols: EtherNet/IP,Modbus-TCP,CIP,DeviceNet,ControlNet
  motion: CIP-Motion,Kinematics | safety: IEC-61508-SIL2,ISO-13849-PLd

