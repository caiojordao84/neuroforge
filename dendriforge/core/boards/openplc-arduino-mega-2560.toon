## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# OpenPLC v3 Mega mapping (slave offset=100):
# DI:  D22=%IX100.0 .. D45=%IX100.23  (24 DI, digital pins 22-45)
# DO:  D2=%QX100.0  .. D17=%QX100.15 (16 DO, digital pins 2-17)
# AI:  A0=%IW100    .. A15=%IW115     (16 AI, pins A0-A15)
# AO:  D2=%QW100    .. D13=%QW111    (12 AO/PWM, pins 2-13)
# Note: DO and AO share pins 2-13; AO = PWM mode, DO = digital mode
gpio[52|]{pin|type|pwm|int|label|roles}:
  2|digital|true|false|"D2 / %QX100.0 (DO) / %QW100 (AO/PWM)"|"do;dac"
  3|digital|true|true|"D3 / %QX100.1 (DO) / %QW101 (AO/PWM)"|"do;dac"
  4|digital|true|false|"D4 / %QX100.2 (DO) / %QW102 (AO/PWM)"|"do;dac"
  5|digital|true|false|"D5 / %QX100.3 (DO) / %QW103 (AO/PWM)"|"do;dac"
  6|digital|true|false|"D6 / %QX100.4 (DO) / %QW104 (AO/PWM)"|"do;dac"
  7|digital|true|false|"D7 / %QX100.5 (DO) / %QW105 (AO/PWM)"|"do;dac"
  8|digital|true|false|"D8 / %QX100.6 (DO) / %QW106 (AO/PWM)"|"do;dac"
  9|digital|true|false|"D9 / %QX100.7 (DO) / %QW107 (AO/PWM)"|"do;dac"
  10|digital|true|false|"D10 / %QX100.8 (DO) / %QW108 (AO/PWM)"|"do;dac"
  11|digital|true|false|"D11 / %QX100.9 (DO) / %QW109 (AO/PWM)"|"do;dac"
  12|digital|true|false|"D12 / %QX100.10 (DO) / %QW110 (AO/PWM)"|"do;dac"
  13|digital|true|false|"D13 / %QX100.11 (DO) / %QW111 (AO/PWM) / LED"|"do;dac;status-led"
  14|digital|false|false|"D14 / %QX100.12 (DO) / TX3"|uart-tx
  15|digital|false|false|"D15 / %QX100.13 (DO) / RX3"|uart-rx
  16|digital|false|false|"D16 / %QX100.14 (DO) / TX2"|uart-tx
