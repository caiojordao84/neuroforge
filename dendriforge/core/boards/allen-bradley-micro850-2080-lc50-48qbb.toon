## 7. RESTRICTIONS & COMPATIBILITY:
restrictions:
  supply_voltage: 24V
  supply_current_max: 1400mA
  io_output_current_max: 1000mA
  sensor_supply_current: 400mA
  operating_temp: "0-65°C"
  storage_temp: "-40-85°C"
  protection_class: IP20
  warnings[6]:
    - "Supply voltage must be 24V DC (20.4-26.4V); AC input version is 2080-LC50-48AWB"
    - "12 HS inputs (IX0.0-IX1.3) share channels with 6 HSC counters at up to 100kHz"
    - "4 HS outputs (QX0.0-QX0.3) share channels with 3 PTO/PWM channels"
    - "Analog I/O requires plug-in modules (2080-IF2, 2080-OF2, 2080-IF4); none onboard"
    - "Maximum 4 local expansion I/O modules; maximum total 132 I/O points"
    - "RS232 and RS485 are non-isolated; cannot be used simultaneously"
compatibility:
  standard: "IEC 61131-3"
  ide: "Connected Components Workbench (CCW) v21+"
  runtime: "Micro850 FW11"
  languages: "LD;FBD;ST;SFC;IL"
  order_ref: "2080-LC50-48QBB"

