## 3. ELECTRICAL PROFILE (POWER PINS):
# Format: name | direction | voltage | type
# /ES = AC power supply (100-240VAC); /DS = DC power supply (24VDC)
# Input: 100-240VAC 50/60Hz; range 85-264VAC; max 110VA; inrush 100A@264VAC cold
# 24VDC service power supply output: max 400mA for base unit (32MR/ES with no expansion)
# CAUTION: do NOT externally power [24+] and [24V] service terminals — this WILL damage the CPU
# Class D grounding (≤100Ω) required on FG terminal; use ≥2mm² wire
# FG: Functional Earth for EMC — NOT the same as PE; connect to system earth separately
powerPins[6|]{name|direction|voltage|type}:
  L_AC|input|"230V"|null
  N_AC|null|null|ground
  FG|null|null|ground
  SENS_24V|output|"24V"|null
  SENS_GND|null|null|ground
  V0V_OUTPUT_COM|null|null|ground

## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# DI: X000-X017 (octal addressing, 16 points); 24VDC sink/source; M3 screw detachable terminal
# X000-X005: 200kHz HSC; 2.5µs ON/OFF delay; 5.3mA@24VDC; 4.3kΩ input resistance
# X006-X007: 10kHz; 30µs ON / 50µs OFF; 4mA@24VDC; 5.6kΩ
# X010-X017: standard; 4mA; 5.6kΩ; default 10ms digital filter; configurable 0.2ms-70ms
# DO: Y000-Y017 (16 relay outputs); 250VAC/30VDC max; 2A/point resistive; ~10ms relay response
# RELAY OUTPUTS CANNOT generate PWM or pulse output — use FX5U-32MT/ES for pulse output
# AI: built-in ch1-ch2 (0-10VDC 12-bit); AO: built-in ch1 (0-10VDC 12-bit); screw terminal
gpio[37|]{pin|type|pwm|int|label|roles}:
  0|digital|false|true|"X000 / HSC ch0 A-phase — Digital Input 0; 24VDC sink/source; 200kHz high-speed counter input; ON delay 2.5µs; OFF delay 2.5µs; 5.3mA@24VDC; 4.3kΩ; interrupt-capable; pair with X001 for A/B quadrature 200kHz; M3 screw detachable terminal"|"di"
  1|digital|false|true|"X001 / HSC ch0 B-phase — Digital Input 1; 24VDC sink/source; 200kHz HSC; 2.5µs ON/OFF; interrupt; B-phase pair for X000 quadrature; also ch1 single-phase if configured separately"|"di"
  2|digital|false|true|"X002 / HSC ch1 A — Digital Input 2; 24VDC; 200kHz HSC; 2.5µs ON/OFF; interrupt"|"di"
  3|digital|false|true|"X003 / HSC ch1 B — Digital Input 3; 24VDC; 200kHz HSC; 2.5µs ON/OFF; interrupt"|"di"
  4|digital|false|true|"X004 / HSC ch2 A — Digital Input 4; 24VDC; 200kHz HSC; 2.5µs ON/OFF; interrupt"|"di"
  5|digital|false|true|"X005 / HSC ch2 B — Digital Input 5; 24VDC; 200kHz HSC; 2.5µs ON/OFF; interrupt; last 200kHz input; X000-X005 = up to 6ch 200kHz when all configured single-phase"|"di"
  6|digital|false|true|"X006 / HSC ch3 A — Digital Input 6; 24VDC sink/source; 10kHz HSC; ON delay 30µs; OFF delay 50µs; 4mA@24VDC; 5.6kΩ; interrupt"|"di"
  7|digital|false|true|"X007 / HSC ch3 B — Digital Input 7; 24VDC; 10kHz HSC; 30µs ON/50µs OFF; interrupt; X006-X007 = 2ch 10kHz HSC"|"di"
  8|digital|false|true|"X010 — Digital Input 8; 24VDC sink/source; standard input; 4mA@24VDC; 5.6kΩ; digital filter default 10ms; configurable 0.2ms-70ms (none-10µs-0.1ms-0.2ms-0.4ms-0.6ms-1ms-5ms-10ms-20ms-70ms); interrupt-capable"|"di"
  9|digital|false|true|"X011 — Digital Input 9; 24VDC; standard; filter configurable; interrupt"|"di"
  10|digital|false|true|"X012 — Digital Input 10; 24VDC; standard; interrupt"|"di"
  11|digital|false|true|"X013 — Digital Input 11; 24VDC; standard; interrupt"|"di"
  12|digital|false|true|"X014 — Digital Input 12; 24VDC; standard; interrupt"|"di"
  13|digital|false|true|"X015 — Digital Input 13; 24VDC; standard; interrupt"|"di"
  14|digital|false|true|"X016 — Digital Input 14; 24VDC; standard; interrupt"|"di"
  15|digital|false|true|"X017 — Digital Input 15; 24VDC; standard; last built-in DI; interrupt"|"di"
  16|digital|false|false|"Y000 — Relay Output 0; SPST-NO Form A relay; max 250VAC or 30VDC; 2A resistive per point; min load DC5V 2mA; response ~10ms; mechanical insulation; LED indicator; M3 screw detachable terminal; NO PWM or pulse capability on relay model — use FX5U-32MT/ES for PTO/PWM"|"do"
  17|digital|false|false|"Y001 — Relay Output 1; same specs as Y000; 2A 250VAC/30VDC; ~10ms"|"do"
  18|digital|false|false|"Y002 — Relay Output 2; 2A 250VAC/30VDC; relay mechanical insulation"|"do"
  19|digital|false|false|"Y003 — Relay Output 3; 2A 250VAC/30VDC"|"do"
  20|digital|false|false|"Y004 — Relay Output 4; 2A 250VAC/30VDC"|"do"
  21|digital|false|false|"Y005 — Relay Output 5; 2A 250VAC/30VDC"|"do"
  22|digital|false|false|"Y006 — Relay Output 6; 2A 250VAC/30VDC"|"do"
  23|digital|false|false|"Y007 — Relay Output 7; 2A 250VAC/30VDC"|"do"
  24|digital|false|false|"Y010 — Relay Output 8; 2A 250VAC/30VDC"|"do"
  25|digital|false|false|"Y011 — Relay Output 9; 2A 250VAC/30VDC"|"do"
  26|digital|false|false|"Y012 — Relay Output 10; 2A 250VAC/30VDC"|"do"
  27|digital|false|false|"Y013 — Relay Output 11; 2A 250VAC/30VDC"|"do"
  28|digital|false|false|"Y014 — Relay Output 12; 2A 250VAC/30VDC"|"do"
  29|digital|false|false|"Y015 — Relay Output 13; 2A 250VAC/30VDC"|"do"
  30|digital|false|false|"Y016 — Relay Output 14; 2A 250VAC/30VDC"|"do"
  31|digital|false|false|"Y017 — Relay Output 15; 2A 250VAC/30VDC; last built-in relay output"|"do"
  32|analog|false|false|"AI ch1 (VIN1) — Built-in Analog Input 1; 0-10VDC unipolar; 12-bit (0-4095 raw); no isolation from CPU; parameter-based scaling; numerical shift; warning output configurable; use twisted shielded pair; max cable per Mitsubishi guidelines; screw terminal on CPU front"|"adc:t"
  33|analog|false|false|"AI ch2 (VIN2) — Built-in Analog Input 2; 0-10VDC; 12-bit; same specs as AI ch1; shield at CPU end only; do NOT connect to external power source"|"adc:t"
  34|analog|false|false|"AO ch1 (VOUT) — Built-in Analog Output 1; 0-10VDC; 12-bit (0-4095 raw); no isolation from CPU; parameter-based; scaling; used for e.g. speed reference to inverter; max load capacitance per Mitsubishi guidelines; screw terminal on CPU front"|"adc:t"
  35|digital|false|false|"ETH (10BASE-T/100BASE-TX) — Built-in Ethernet port; RJ45; 10/100 Mbps; IP configurable static or DHCP; max 8 simultaneous connections; protocols: SLMP-MC-protocol-binary-ASCII, MELSOFT-GX Works3-remote, open-TCP-UDP, MODBUS-TCP-client+server, CC-Link-IE-Field-Basic-V1.200+; hub required for multiple devices"|"do;di"
  36|digital|false|false|"RS-485 (built-in) — 2-wire half-duplex; RJ45 or terminal block; max cable 50m; 300-115200 bps configurable; protocols: MODBUS-RTU-master+slave-up-to-32-devices-incl-master, Mitsubishi-inverter-protocol-up-to-16-units-FR-series-6-commands, non-procedure; termination resistor: install at both ends for cables >10m"|"do;di"

