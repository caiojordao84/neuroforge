## 4. GPIO MAP:
# Format: pin | type | pwm | int | label | roles
# Inputs I1..I8: digital 24VDC/24VAC; I1..I4 dual-use as 0-10V analog (12-bit)
# Outputs Q1..Q4: relay make-contact NO, 8A/250VAC
# Ethernet: RJ45 10/100Mbps
# SD slot: Micro SD (optional, program transfer only)
# Expansion: side connector (proprietary easyConnect)
gpio[15|]{pin|type|pwm|int|label|roles}:
  1|analog|false|true|"I1 — DI or AI (0-10V, 12-bit); also DCF77 time sync input; max 24VDC/AC; interrupt-capable"|"di;adc:t"
  2|analog|false|true|"I2 — DI or AI (0-10V, 12-bit); max 24VDC/AC; interrupt-capable"|"di;adc:t"
  3|analog|false|true|"I3 — DI or AI (0-10V, 12-bit); max 24VDC/AC; interrupt-capable"|"di;adc:t"
  4|analog|false|true|"I4 — DI or AI (0-10V, 12-bit); max 24VDC/AC; interrupt-capable"|"di;adc:t"
  5|digital|false|false|"I5 — DI only; 24VDC/AC; fast input for counting/frequency"|di
  6|digital|false|false|"I6 — DI only; 24VDC/AC"|di
  7|digital|false|false|"I7 — DI only; 24VDC/AC"|di
  8|digital|false|false|"I8 — DI only; 24VDC/AC"|di
  11|digital|false|false|"Q1 — Relay output NO make-contact; 8A/250VAC; 8A/30VDC resistive; NOT short-circuit protected"|do
  12|digital|false|false|"Q2 — Relay output NO make-contact; 8A/250VAC; 8A/30VDC resistive; NOT short-circuit protected"|do
  13|digital|false|false|"Q3 — Relay output NO make-contact; 8A/250VAC; 8A/30VDC resistive; NOT short-circuit protected"|do
  14|digital|false|false|"Q4 — Relay output NO make-contact; 8A/250VAC; 8A/30VDC resistive; NOT short-circuit protected"|do
  30|digital|false|false|"Ethernet / RJ45 — 10/100Mbps; Modbus TCP client+server; easyNet NET; web server; easySoft online; SMTP email alarm"|"eth"
  40|digital|false|false|"Micro SD slot — program transfer and data logging ONLY; MEMORY-SDU-A1 2GB; NOT hot-swappable during operation"|null
  50|digital|false|false|"Expansion connector (easyConnect) — up to 11 expansion modules; mixed AC/DC/UC; max 188 total I/O per cluster"|null

