  serial|"baud:187500"|"proto:RS485;standard:MPI"
service:
  type: "MPI/DP"
  connector: "DB9"
  protocol: "MPI"

## 7. RESTRICTIONS & COMPATIBILITY:
restrictions:
  max_io_current: "1200mA"
  total_current_limit: "1200mA"
  operating_temp: "0-60C"
  protection_class: IP20
  warnings[4]:
    - "MPI and PROFIBUS DP share the same front connector on CPU"
    - "Maximum 4 racks (1 central + 3 expansion) with IM 365 or IM 360/361"
    - "No integrated Ethernet; requires CP 343-1 module for PROFINET or TCP/IP"
    - "Load memory size depends on inserted Micro Memory Card (MMC) capacity"
compatibility:
  standard: "IEC 61131-3"
  ide: "STEP 7 V5.5"
  runtime: "S7-300 V3.3"
  languages: "LD;FBD;ST;SFC"

