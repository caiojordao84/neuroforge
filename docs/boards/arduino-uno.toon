# Arduino Uno R3 - Board Configuration TOON
# Migrated from arduino-uno.json (v2.0 → TOON v3.0)
# Includes svgMap and aslProfile fields per architecture v3

id: arduino-uno
name: Arduino Uno R3
manufacturer: Arduino
mcu: ATmega328P
category: maker
family: avr-family
image: /boards/arduino-uno.svg
url: https://store.arduino.cc/products/arduino-uno-rev3

# ─────────────────────────────────────────────────────────────────────────────
# SPECS - Extended with frequencyMhz (Section 3.1 fix)

specs:
  flashMemory: 32768       # bytes (32KB)
  sram: 2048              # bytes (2KB)
  eeprom: 1024            # bytes (1KB)
  clockSpeed: 16000000    # Hz (16MHz)
  frequencyMhz: 16        # NEW - alternate representation
  voltage: 5.0            # V

# ─────────────────────────────────────────────────────────────────────────────
# DIMENSIONS

dimensions:
  width: 68.6
  height: 53.4
  thickness: 1.6

# ─────────────────────────────────────────────────────────────────────────────
# POWER PINS - Using new enum values (Section 3.1 fix)

powerPins:
  | name   | voltage | direction |
  | VIN    |         | input     |
  | 5V     | 5.0     | output    |
  | 3V3    | 3.3     | output    |
  | GND    |         |           |
  | RESET  |         | input     |
  | IOREF  | 5.0     | output    |
  | AREF   |         | input     |

# ─────────────────────────────────────────────────────────────────────────────
# GPIO - Now with physicalPin (Section 3.1 fix)

gpio:
  # Digital pins 0-13
  | pin | physicalPin | label        | pwm   | interrupt | adc  | strapping | warning                              |
  | 0   | 1           | D0 / RX      | false | true      | false| false     | Serial RX — avoid                     |
  | 1   | 2           | D1 / TX      | false | true      | false| false     | Serial TX — avoid                     |
  | 2   | 4           | D2           | false | true      | false| false     |                                       |
  | 3   | 5           | D3 PWM       | true  | true      | false| false     |                                       |
  | 4   | 6           | D4           | false | false     | false| false     |                                       |
  | 5   | 7           | D5 PWM       | true  | false     | false| false     |                                       |
  | 6   | 8           | D6 PWM       | true  | false     | false| false     |                                       |
  | 7   | 9           | D7           | false | false     | false| false     |                                       |
  | 8   | 10          | D8           | false | false     | false| false     |                                       |
  | 9   | 11          | D9 PWM       | true  | false     | false| false     |                                       |
  | 10  | 12          | D10 PWM / SS | true  | false     | false| false     |                                       |
  | 11  | 13          | D11 PWM / MOSI| true | false     | false| false     |                                       |
  | 12  | 14          | D12 / MISO   | false | false     | false| false     |                                       |
  | 13  | 15          | D13 / LED / SCK| false| false     | false| false     | Built-in LED                          |
  
  # Analog pins A0-A5 (pins 14-19)
  | pin | physicalPin | label        | pwm   | interrupt | adc  | strapping | warning |
  | 14  | 23          | A0           | false | false     | true | false     |         |
  | 15  | 24          | A1           | false | false     | true | false     |         |
  | 16  | 25          | A2           | false | false     | true | false     |         |
  | 17  | 26          | A3           | false | false     | true | false     |         |
  | 18  | 27          | A4 / SDA     | false | false     | true | false     | I2C SDA |
  | 19  | 28          | A5 / SCL     | false | false     | true | false     | I2C SCL |

# ─────────────────────────────────────────────────────────────────────────────
# PERIPHERALS

peripherals:
  serial:
    uarts: 1
    pins: [0, 1]
  i2c:
    channels: 1
    sda: 18
    scl: 19
  spi:
    channels: 1
    miso: 12
    mosi: 11
    sck: 13
    ss: 10

# ─────────────────────────────────────────────────────────────────────────────
# USB

usb:
  type: USB-B
  chipset: ATmega16U2
  vid: "0x2341"
  pid: "0x0043"

# ─────────────────────────────────────────────────────────────────────────────
# RESTRICTIONS

restrictions:
  outputCurrent: 40  # mA per pin
  warnings:
    - Pins 0 and 1 are used for USB serial communication
    - Pin 13 has an onboard LED which may interfere with some applications
    - Maximum total current from all I/O pins: 200mA

# ─────────────────────────────────────────────────────────────────────────────
# COMPATIBILITY

compatibility:
  arduinoCore: 1.8.19
  platformio: atmelavr
  frameworks: [arduino]

# ─────────────────────────────────────────────────────────────────────────────
# LANGUAGES

languages: [arduino-cpp]

bootloader: optiboot

# ─────────────────────────────────────────────────────────────────────────────
# Section 3.2 - svgMap (coordinates from assets/boards/arduino-uno.svg)
# NOTE: SVG file not yet created — path updated from arduino-uno-r3.svg (fix)

svgMap:
  file: assets/boards/arduino-uno.svg
  viewBox: 0 0 500 360
  # Coordinates extracted from SVG - will be populated by SchemaSmith
  pins:
    | id        | logicalPin | physicalPin | cx    | cy    | side  |
    | pin-d0    | 0          | 1           | 142.5 | 28.0  | right |
    | pin-d1    | 1          | 2           | 142.5 | 44.0  | right |
    | pin-d2    | 2          | 4           | 142.5 | 60.0  | right |
    | pin-d3    | 3          | 5           | 142.5 | 76.0  | right |
    | pin-d4    | 4          | 6           | 142.5 | 92.0  | right |
    | pin-d5    | 5          | 7           | 142.5 | 108.0 | right |
    | pin-d6    | 6          | 8           | 142.5 | 124.0 | right |
    | pin-d7    | 7          | 9           | 142.5 | 140.0 | right |
    | pin-d8    | 8          | 10          | 142.5 | 156.0 | right |
    | pin-d9    | 9          | 11          | 142.5 | 172.0 | right |
    | pin-d10   | 10         | 12          | 142.5 | 188.0 | right |
    | pin-d11   | 11         | 13          | 142.5 | 204.0 | right |
    | pin-d12   | 12         | 14          | 142.5 | 220.0 | right |
    | pin-d13   | 13         | 15          | 142.5 | 236.0 | right |
    | pin-a0    | 14         | 23          | 142.5 | 260.0 | right |
    | pin-a1    | 15         | 24          | 142.5 | 276.0 | right |
    | pin-a2    | 16         | 25          | 142.5 | 292.0 | right |
    | pin-a3    | 17         | 26          | 142.5 | 308.0 | right |
    | pin-a4    | 18         | 27          | 142.5 | 324.0 | right |
    | pin-a5    | 19         | 28          | 142.5 | 340.0 | right |

# ─────────────────────────────────────────────────────────────────────────────
# Section 3.3 - aslProfile (NEW)

aslProfile:
  targets:
    | language    | targetId              | hal              | std   | alloc | confidenceFloor | agentSkill                                |
    | arduino-cpp | arduino-uno-avr       | arduino-avr-hal  | false | false | 0.97            | agent_skills/languages/arduino-cpp-avr.md |
