# ESP8266 NodeMCU - Board Configuration TOON
# Phase B board - ESP8266 (Xtensa LX106)

id: esp8266-nodemcu
name: ESP8266 NodeMCU
manufacturer: Espressif Systems
mcu: ESP8266
category: maker
family: esp32-family
image: /assets/boards/esp8266-nodemcu.svg
url: https://www.nodemcu.com/index.html

# ─────────────────────────────────────────────────────────────────────────────
# SPECS

specs:
  flashMemory: 4194304      # bytes (4MB)
  sram: 65536              # bytes (64KB)
  eeprom: 0                # none
  clockSpeed: 80000000     # Hz (80MHz)
  frequencyMhz: 80         # alternate
  voltage: 3.3             # V
  cores: 1                  # Single core Xtensa LX106
  architecture: Xtensa LX106
  wireless:
    - wifi

# ─────────────────────────────────────────────────────────────────────────────
# DIMENSIONS

dimensions:
  width: 25.6
  height: 57.9
  thickness: 1.6

# ─────────────────────────────────────────────────────────────────────────────
# POWER PINS

powerPins:
  | name   | voltage | direction | maxCurrent | notes                         |
  | VIN    | 5.0     | input     |            | 5V input from USB or external|
  | 3V3    | 3.3     | output    | 500        | 3.3V regulated output        |
  | GND    |         |           |            | Ground                       |
  | RST    |         | input     |            | Reset pin (active low)       |

# ─────────────────────────────────────────────────────────────────────────────
# GPIO - With strapping pins (ESP8266 specific)

gpio:
  # GPIO 0-5 (with strapping)
  | pin | physicalPin | label            | pwm  | interrupt | adc  | touch | strapping | warning                                 |
  | 0   | 1           | GPIO0           | true | true      | false| true  | true      | Strapping pin - Boot mode selection    |
  | 1   | 2           | GPIO1 TX        | true | true      | false| false | false     | Serial TX                                |
  | 2   | 3           | GPIO2           | true | true      | false| true  | true      | Strapping pin - Boot voltage selection |
  | 3   | 9           | GPIO3 RX        | true | true      | false| false | false     | Serial RX                                |
  | 4   | 10          | GPIO4           | true | true      | false| true  | false     |                                          |
  | 5   | 12          | GPIO5           | true | true      | false| false | false     |                                          |

  # GPIO 9-16
  | pin | physicalPin | label            | pwm  | interrupt | adc  | touch | strapping | warning |
  | 9   | 11          | GPIO9 SDD2       | false| false     | false| false | false     | Reserved for flash |
  | 10  | 13          | GPIO10 SDD3      | false| false     | false| false | false     | Reserved for flash |
  | 12  | 14          | GPIO12 MTCK      | true | true      | false| false | false     |                    |
  | 13  | 15          | GPIO13 MTDO      | true | true      | false| false | false     | SPI MTDO           |
  | 14  | 16          | GPIO14 MTMS      | true | true      | false| false | false     | SPI SCK            |
  | 15  | 17          | GPIO15 MTDI      | true | true      | false| false | false     | SPI MDI            |
  | 16  | 18          | GPIO16           | true | true      | false| false | false     | Wake from deep sleep|

# ─────────────────────────────────────────────────────────────────────────────
# PERIPHERALS

peripherals:
  serial:
    uarts: 2
    default:
      tx: 1
      rx: 3
  i2c:
    channels: 1
    default:
      sda: 4
      scl: 5
  spi:
    channels: 1
    default:
      miso: 12
      mosi: 13
      sck: 14
  adc:
    channels: 1
    resolution: 10
    pins: [0]
  wifi:
    protocols:
      - 802.11b
      - 802.11g
      - 802.11n
    modes:
      - sta
      - ap

# ─────────────────────────────────────────────────────────────────────────────
# USB

usb:
  type: micro-USB
  chipset: CP2102
  vid: "0x10C4"
  pid: "0xEA60"

# ─────────────────────────────────────────────────────────────────────────────
# LEDS

leds:
  | id           | color  | function    | linkedPin |
  | led-power    | green  | power       |           |
  | led-gpio2    | blue   | user        | 2         |

# ─────────────────────────────────────────────────────────────────────────────
# BUTTONS

buttons:
  | id             | linkedPin | function | activeLevel |
  | reset-button   | RST      | reset    | low         |
  | flash-button   | 0        | boot     | low         |

# ─────────────────────────────────────────────────────────────────────────────
# RESTRICTIONS

restrictions:
  strappingPins: [0, 2]
  reservedPins: [9, 10]  # Connected to SPI flash
  outputCurrent: 12  # mA per pin
  warnings:
    - GPIO 9, 10 are connected to the integrated SPI flash (DO NOT USE)
    - GPIO 0, 2 are strapping pins - use with caution during boot
    - GPIO 1 and 3 are used for Serial debugging (USB)
    - GPIO 16 is used for wake from deep sleep
    - System voltage is 3.3V, not 5V tolerant

# ─────────────────────────────────────────────────────────────────────────────
# COMPATIBILITY

compatibility:
  arduinoCore: 2.7.4
  platformio: espressif8266
  frameworks:
    - arduino
    - esp8266-nonos-sdk

# ─────────────────────────────────────────────────────────────────────────────
# LANGUAGES

languages:
  - arduino-cpp
  - micropython

bootloader: esp8266-bootloader

# ─────────────────────────────────────────────────────────────────────────────
# QEMU

qemu:
  machine: esp8266
  cpu: esp8266
  requiresFlash: true

# ─────────────────────────────────────────────────────────────────────────────
# svgMap

svgMap:
  file: assets/boards/esp8266-nodemcu.svg
  viewBox: 0 0 400 600
  pins:
  | id           | logicalPin | physicalPin | cx    | cy    | side  |
  | pin-3v3      | 3V3        |              | 50    | 180   | left  |
  | pin-rst      | RST        |              | 50    | 210   | left  |
  | pin-gpio4    | 4          | 10           | 50    | 240   | left  |
  | pin-gpio5    | 5          | 12           | 50    | 270   | left  |
  | pin-gpio0    | 0          | 1            | 50    | 300   | left  |
  | pin-gpio2    | 2          | 3            | 50    | 330   | left  |
  | pin-gpio14   | 14         | 16           | 50    | 360   | left  |
  | pin-gpio12   | 12         | 14           | 50    | 390   | left  |
  | pin-gnd-left | GND        |              | 50    | 420   | left  |
  | pin-gnd2     | GND        |              | 50    | 450   | left  |
  | pin-vin      | VIN        |              | 50    | 480   | left  |
  | pin-gpio1    | 1          | 2            | 350   | 180   | right |
  | pin-gpio3    | 3          | 9            | 350   | 210   | right |
  | pin-gpio13   | 13         | 15           | 350   | 240   | right |
  | pin-gpio15   | 15         | 17           | 350   | 270   | right |
  | pin-gpio16   | 16         | 18           | 350   | 300   | right |
  | pin-gpio10   | 10         | 13           | 350   | 330   | right |
  | pin-gpio9    | 9          | 11           | 350   | 360   | right |

# ─────────────────────────────────────────────────────────────────────────────
# aslProfile

aslProfile:
  targets:
    | language    | targetId                | hal               | std   | alloc | confidenceFloor | agentSkill                                  |
    | arduino-cpp | esp8266-nodemcu-arduino | esp8266-arduino  | true  | true  | 0.85            | agent_skills/languages/arduino-cpp-esp8266.md |
    | micropython | esp8266-nodemcu-mp      | esp8266          | true  | true  | 0.88            | agent_skills/languages/micropython-esp8266.md |
