{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@neuroforge/shared/*": ["./apps/shared/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}