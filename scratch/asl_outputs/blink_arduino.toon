aslVersion: "0.1.0"
metadata:
  name: "blink_arduino"
  version: "1"
  editor: "dendriForge"
  author: "transpiler-tester"
parts:
  - id: "MCU_0"
    type: "arduino-uno-r3"
  - id: "LED_0"
    type: "led-simple"
connections:
  - ["MCU_0:13", "LED_0:A", "red", "v0"]
  - ["LED_0:C", "MCU_0:GND.1", "black", "v0"]
tasks:
  - name: "setup"
    body:
      - {kind: "pinMode", pin: 13, mode: "OUTPUT"}
  - name: "loop"
    body:
      - {kind: "digitalWrite", pin: 13, value: "HIGH"}
      - {kind: "delay", ms: 1000}
      - {kind: "digitalWrite", pin: 13, value: "LOW"}
      - {kind: "delay", ms: 1000}
