// --- ASL Formal Grammar Definition ---
// Whitespace and comments are automatically ignored by Pest
WHITESPACE = _{ " " | "\t" }
COMMENT = _{ ("#" | "//") ~ (!NEWLINE ~ ANY)* }

// The root of the document
asl_document = { SOI ~ metadata_block? ~ hardware_block? ~ data_block? ~ state_block? ~ timers_block? ~ routines_block ~ EOI }

// --- 1. Metadata Block ---
metadata_block = { "##" ~ ANY* ~ "METADATA:" ~ NEWLINE* ~ metadata_entry* }
metadata_entry = { ident ~ ":" ~ (!NEWLINE ~ ANY)* ~ NEWLINE+ }

// --- 2. Hardware Block ---
hardware_block = { "##" ~ ANY* ~ "HARDWARE INTERFACE:" ~ NEWLINE* ~ "hardware[" ~ ASCII_DIGIT+ ~ "|" ~ ANY* ~ "]:" ~ NEWLINE* ~ hw_entry* }
hw_entry = { ASCII_DIGIT+ ~ "|" ~ ident ~ "|" ~ ident ~ "|" ~ string_literal ~ "|" ~ string_literal ~ NEWLINE+ }

// --- 3. Memory Blocks (Data & State) ---
data_block = { "##" ~ ANY* ~ "SYSTEM DATA:" ~ NEWLINE* ~ "data:" ~ NEWLINE+ ~ var_entry* }
state_block = { "state:" ~ NEWLINE+ ~ var_entry* }
var_entry = { ident ~ ":" ~ (!NEWLINE ~ ANY)+ ~ NEWLINE+ }

// --- 4. Timers Block ---
timers_block = { "timers:" ~ NEWLINE+ ~ timer_entry* }
timer_entry = { ident ~ ":" ~ "{" ~ (!"}" ~ ANY)* ~ "}" ~ NEWLINE+ }

// --- 5. Routines (Logic) ---
routines_block = { routine_def* }
routine_def = { ident ~ "(" ~ routine_args? ~ ")" ~ routine_decorator? ~ ":" ~ NEWLINE+ ~ routine_body }

// The execution time decorator e.g. [50]
routine_decorator = { "[" ~ ASCII_DIGIT+ ~ "]" }

// Commas separated arguments
routine_args = { ident ~ ("," ~ ident)* }

// The body expects statements prefixed by hyphens as per the TOON example
routine_body = { statement+ }
statement = { "-" ~ (!NEWLINE ~ ANY)+ ~ NEWLINE+ }

// --- Core Primitives ---
ident = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
string_literal = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
