# NeuroForge Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# AI Provider Configuration (Server-Side)
# ============================================

# Choose your AI provider: openai or anthropic
# Example: export AI_PROVIDER_TYPE=anthropic
# AI_PROVIDER_TYPE=anthropic

# Model selection (optional - defaults provided)
# For Anthropic: anthropic/claude-3-5-sonnet-20241022
# For OpenAI: openai/gpt-4o
# AI_MODEL=anthropic/claude-3-5-sonnet-20241022

# API Keys (server-side only - DO NOT expose to client)
# These variables are only available server-side in SvelteKit
# Example: export OPENAI_API_KEY=sk-...
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ============================================
# Development Settings
# ============================================

# Vite-specific prefix (exposed to client as import.meta.env.VITE_*)
# Only use VITE_ prefix for values that need to be exposed to the browser
# VITE_APP_TITLE=NeuroForge

# ============================================
# Note on Security
# ============================================
# 
# IMPORTANT: API keys stored in regular environment variables 
# (not VITE_ prefix) are only available server-side in SvelteKit.
# They will NOT be exposed to the browser, keeping your keys secure.
#
# NEVER commit actual API keys to version control!